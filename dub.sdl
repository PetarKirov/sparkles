name "sparkles"
description "D library"
authors "Petar Kirov"
copyright "Copyright © 2023, Petar Kirov"
license "BSL-1.0"

targetPath "build"

subPackage "apps/ci"
subPackage "apps/diagram"
subPackage "apps/hue"
subPackage "apps/nix-eval"
subPackage "apps/release"
subPackage "apps/shader-compile"
subPackage "apps/terminal"
subPackage "apps/twoslash-extract"
subPackage "apps/terminal-benchmark"
subPackage "apps/text-lab"
subPackage "apps/ui-gallery"
subPackage "libs/android"
subPackage "libs/base"
subPackage "libs/base/tools/text-conformance"
subPackage "libs/build-primitives"
subPackage "libs/code-instrumentation"
subPackage "libs/core-cli"
subPackage "libs/diff"
subPackage "libs/dmd-fmt"
subPackage "libs/dmd-lsp"
subPackage "libs/doc-view"
subPackage "libs/docs"
subPackage "libs/dql"
subPackage "libs/dsv"
subPackage "libs/font"
subPackage "libs/font-oracle"
subPackage "libs/event-horizon"
subPackage "libs/event-horizon-sys"
subPackage "libs/fuzzy"
subPackage "libs/ghostty"
subPackage "libs/http"
subPackage "libs/image"
subPackage "libs/input"
subPackage "libs/math"
subPackage "libs/metadata"
subPackage "libs/nix"
subPackage "libs/raylib-text"
subPackage "libs/reflection"
subPackage "libs/shaders"
subPackage "libs/source-view"
subPackage "libs/syntax"
subPackage "libs/terminal-view"
subPackage "libs/test-runner"
subPackage "libs/test-runner-impl"
subPackage "libs/test-utils"
subPackage "libs/tree-sitter"
subPackage "libs/tui"
subPackage "libs/twoslash"
subPackage "libs/twoslash-d"
subPackage "libs/twoslash-protocol"
subPackage "libs/ui"
subPackage "libs/ui-app"
subPackage "libs/ui-raylib"
subPackage "libs/ui-sdl3"
subPackage "libs/ui-tui"
subPackage "libs/ui-vulkan"
subPackage "libs/versions"
subPackage "libs/vulkan"
subPackage "libs/vulkan-wsi"
subPackage "libs/wsi"
subPackage "libs/wired"

// BEGIN managed build types — apps/ci/tools/standardize-build-settings.d
dflags "--linker=lld" platform="linux-ldc"
dflags "-L-fuse-ld=lld" platform="linux-dmd"

buildType "unittest" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-debug" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov" {
    buildOptions "unittests" "coverage" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov-ctfe" {
    buildOptions "unittests" "coverageCTFE" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
buildType "bench" {
    buildOptions "unittests" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-unchecked" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-static" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "--link-defaultlib-shared=false" platform="linux-ldc"
    dflags "-defaultlib=libphobos2.a" platform="linux-dmd"
    lflags "--export-dynamic" platform="linux-ldc"
}
// END managed build types
