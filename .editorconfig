# EditorConfig file: http://EditorConfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{d,h,hpp,c,cpp,cxx,cs,hs,java,kt,py,rs,sol,sdl}]
indent_size = 4

[{dub.selections.json,Makefile,go.mod,go.sum,*.go,.gitmodules}]
indent_style = tab
indent_size = 4

[{CMakeLists.txt,*.cmake}]
indent_size = 2
indent_style = space

# Disable indent checking for prettyprint.d - contains multiline string literals
# with intentional 2-space indentation for expected test output
[libs/core-cli/src/sparkles/core_cli/prettyprint.d]
indent_size = unset

# Test data files contain exact byte sequences — no trailing newline
[libs/ui/test/data/**]
charset = unset
insert_final_newline = unset

# The DSV sample corpus: the defect fixture deliberately carries a BOM, CRLF
# terminators and no trailing newline (docs/specs/hue/dsv-preview.md DSM3).
[apps/hue/samples/dsv/**]
charset = unset
end_of_line = unset
insert_final_newline = unset

# Markdown rendering fixtures + their rendered-grid goldens: byte-exact test
# data (fixture indentation is markdown syntax; golden columns are layout).
[libs/{syntax,source-view}/test/data/**]
charset = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# The ui-gallery page goldens: a frame photographed as text, so every column is
# layout rather than indentation and trailing blanks are trimmed by the renderer
# (apps/ui-gallery/src/render.d, `render.golden`).
[apps/ui-gallery/test/goldens/**]
charset = unset
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# Exact upstream DUB recipe snapshot; preserve its original tab indentation.
[libs/wired/src/sparkles/wired/sdl/fixtures/*.snapshot.sdl]
indent_style = unset
indent_size = unset

# The Android debug signing keystore is a binary artifact, checked in so the
# APK signature stays stable across rebuilds (see
# nix/packages/android/build-apk.nix)
[apps/hue/android/debug-only.keystore]
charset = unset
end_of_line = unset
insert_final_newline = unset

# Compiled SPIR-V, checked in beside the GLSL it was generated from so no CI
# job needs a shader compiler (see libs/vulkan-wsi/src/shaders/). Binary, and
# a stream of 32-bit words rather than lines.
[*.spv]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# Disable indent checking for markdown - code blocks may have intentional
# spacing for visual output examples
[*.md]
indent_size = unset

# Also disable charset checking for markdown that embeds ```ansi code blocks
# with raw ANSI escape codes (non-printable chars). The README qualifies too:
# its OSC 8 example output carries a BEL terminator, which editorconfig-checker
# 3.7.0 sniffs as "binary" (ESC alone is fine — BEL is what trips it).
[{README.md,docs/**.md}]
charset = unset

# The Make deep-dive embeds real Makefile recipes in fenced code blocks, and
# Make requires literal tabs — so disable indent-style checking for that file.
[docs/research/monorepo-tooling/make/index.md]
indent_style = unset

# These virtualization deep-dives quote upstream Go and TypeScript verbatim, and
# both ecosystems indent with literal tabs — reindenting the excerpts would make
# them stop matching the sources they are pinned to.
[docs/research/ui-virtualization/{gio-list,vscode-listview}.md]
indent_style = unset

# Grounding snapshots preserve upstream/manual indentation rather than project style.
[docs/research/application-packaging/grounding/*]
indent_size = unset

# Twoslash fixture JSON files contain upstream twoslash JSON outputs with custom indentation
[libs/twoslash/examples/fixtures/**]
indent_size = unset

# wayland-scanner output is vendored byte-for-byte apart from the ImportC
# stddef substitution; keep the generator's tabs rather than reformatting it.
[libs/wsi/src/wayland_{xdg_shell,cursor_shape,text_input}_*]
indent_style = unset
indent_size = unset

# The gofmt deep-dive quotes real Go source, and Go is written with literal tabs
# — so disable indent-style checking for that file.
[docs/research/code-formatting/gofmt.md]
indent_style = unset

# These deep-dives quote real Kotlin, Godot C++ and Pango C source, all of which
# upstream writes with literal tabs — keep the quotes byte-exact rather than
# reformatting the evidence.
[docs/research/ui-backend-seam/{pango-harfbuzz,godot-textserver,mosaic}.md]
indent_style = unset

# These deep-dives quote real Linux kernel `arm64` assembly and gofmt'd Go
# source, both of which upstream writes with literal tabs — keep the evidence
# byte-exact rather than reformatting it.
[docs/research/autological-artifacts/{boot-hybrids,content-addressed-chunking}.md]
indent_style = unset
