{
  "$description": "The docs site's light theme: a seed holding the site's current values until the Sparkles theme (M4) replaces them.",
  "$extensions": {
    "dev.petar-kirov.sparkles": {
      "name": "sparkles-site-light"
    }
  },
  "accent": {
    "primary": {
      "bg": {
        "$type": "color",
        "$value": {
          "alpha": 0.12156862745098039,
          "colorSpace": "srgb",
          "components": [0.3882, 0.4, 0.9451],
          "hex": "#6366f1"
        }
      },
      "fg": {
        "$type": "color",
        "$value": "{palette.indigo.500}"
      },
      "hover": {
        "fg": {
          "$type": "color",
          "$value": "{palette.indigo.400}"
        }
      },
      "pressed": {
        "fg": {
          "$type": "color",
          "$value": "{palette.indigo.600}"
        }
      }
    },
    "secondary": {
      "bg": {
        "$type": "color",
        "$value": {
          "alpha": 0.10196078431372549,
          "colorSpace": "srgb",
          "components": [0.1333, 0.8275, 0.9333],
          "hex": "#22d3ee"
        }
      },
      "fg": {
        "$type": "color",
        "$value": "{palette.cyan.400}"
      }
    }
  },
  "border": {
    "default": {
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8863, 0.8863, 0.8902],
          "hex": "#e2e2e3"
        }
      }
    },
    "strong": {
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.7608, 0.7608, 0.7686],
          "hex": "#c2c2c4"
        }
      }
    }
  },
  "font": {
    "body": {
      "$type": "fontFamily",
      "$value": "{font.family.sans}"
    },
    "code": {
      "$type": "fontFamily",
      "$value": "{font.family.mono}"
    },
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": ["Space Grotesk", "Inter", "ui-sans-serif", "system-ui", "sans-serif", "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji"]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["FiraCode Nerd Font Mono", "Fira Code", "Symbols Nerd Font Mono", "Symbols Nerd Font", "JetBrains Mono", "ui-monospace", "Menlo", "Monaco", "Consolas", "Liberation Mono", "Courier New", "monospace"]
      },
      "sans": {
        "$type": "fontFamily",
        "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif", "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji"]
      }
    },
    "heading": {
      "$type": "fontFamily",
      "$value": "{font.family.display}"
    }
  },
  "page": {
    "bg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "fg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.2353, 0.2353, 0.2627],
        "hex": "#3c3c43"
      }
    }
  },
  "palette": {
    "cyan": {
      "300": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4039, 0.9098, 0.9765],
          "hex": "#67e8f9"
        }
      },
      "400": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1333, 0.8275, 0.9333],
          "hex": "#22d3ee"
        }
      }
    },
    "indigo": {
      "300": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.6471, 0.7059, 0.9882],
          "hex": "#a5b4fc"
        }
      },
      "400": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.5059, 0.549, 0.9725],
          "hex": "#818cf8"
        }
      },
      "500": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3882, 0.4, 0.9451],
          "hex": "#6366f1"
        }
      },
      "600": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3098, 0.2745, 0.898],
          "hex": "#4f46e5"
        }
      }
    },
    "violet": {
      "400": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.6549, 0.5451, 0.9804],
          "hex": "#a78bfa"
        }
      }
    }
  },
  "status": {
    "error": {
      "bg": {
        "$type": "color",
        "$value": {
          "alpha": 0.1411764705882353,
          "colorSpace": "srgb",
          "components": [0.9569, 0.2471, 0.3686],
          "hex": "#f43f5e"
        }
      },
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.7216, 0.1529, 0.1725],
          "hex": "#b8272c"
        }
      }
    },
    "success": {
      "bg": {
        "$type": "color",
        "$value": {
          "alpha": 0.1411764705882353,
          "colorSpace": "srgb",
          "components": [0.0627, 0.7255, 0.5059],
          "hex": "#10b981"
        }
      },
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0941, 0.4745, 0.3059],
          "hex": "#18794e"
        }
      }
    },
    "warning": {
      "bg": {
        "$type": "color",
        "$value": {
          "alpha": 0.1411764705882353,
          "colorSpace": "srgb",
          "components": [0.9176, 0.702, 0.0314],
          "hex": "#eab308"
        }
      },
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.5686, 0.349, 0.1882],
          "hex": "#915930"
        }
      }
    }
  },
  "surface": {
    "overlay": {
      "bg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1, 1, 1],
          "hex": "#ffffff"
        }
      }
    },
    "raised": {
      "bg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9647, 0.9647, 0.9686],
          "hex": "#f6f6f7"
        }
      }
    },
    "sunken": {
      "bg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9647, 0.9647, 0.9686],
          "hex": "#f6f6f7"
        }
      }
    }
  },
  "text": {
    "muted": {
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.5725, 0.5725, 0.5843],
          "hex": "#929295"
        }
      }
    },
    "primary": {
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2353, 0.2353, 0.2627],
          "hex": "#3c3c43"
        }
      }
    },
    "secondary": {
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4039, 0.4039, 0.4235],
          "hex": "#67676c"
        }
      }
    }
  }
}
