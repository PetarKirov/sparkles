{
  "$description": "The docs site's dark theme: a seed holding the site's current values until the Sparkles theme (M4) replaces them.",
  "$extensions": {
    "dev.petar-kirov.sparkles": {
      "name": "sparkles-site-dark"
    }
  },
  "accent": {
    "primary": {
      "bg": {
        "$type": "color",
        "$value": {
          "alpha": 0.12156862745098039,
          "colorSpace": "srgb",
          "components": [0.5059, 0.549, 0.9725],
          "hex": "#818cf8"
        }
      },
      "fg": {
        "$type": "color",
        "$value": "{palette.indigo.400}"
      },
      "hover": {
        "fg": {
          "$type": "color",
          "$value": "{palette.indigo.300}"
        }
      },
      "pressed": {
        "fg": {
          "$type": "color",
          "$value": "{palette.indigo.500}"
        }
      }
    },
    "secondary": {
      "bg": {
        "$type": "color",
        "$value": {
          "alpha": 0.0784313725490196,
          "colorSpace": "srgb",
          "components": [0.4039, 0.9098, 0.9765],
          "hex": "#67e8f9"
        }
      },
      "fg": {
        "$type": "color",
        "$value": "{palette.cyan.300}"
      }
    }
  },
  "border": {
    "default": {
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1804, 0.1804, 0.1961],
          "hex": "#2e2e32"
        }
      }
    },
    "strong": {
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2353, 0.2471, 0.2667],
          "hex": "#3c3f44"
        }
      }
    }
  },
  "font": {
    "body": {
      "$type": "fontFamily",
      "$value": "{font.family.sans}"
    },
    "code": {
      "$type": "fontFamily",
      "$value": "{font.family.mono}"
    },
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": ["Space Grotesk", "Inter", "ui-sans-serif", "system-ui", "sans-serif", "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji"]
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["FiraCode Nerd Font Mono", "Fira Code", "Symbols Nerd Font Mono", "Symbols Nerd Font", "JetBrains Mono", "ui-monospace", "Menlo", "Monaco", "Consolas", "Liberation Mono", "Courier New", "monospace"]
      },
      "sans": {
        "$type": "fontFamily",
        "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif", "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji"]
      }
    },
    "heading": {
      "$type": "fontFamily",
      "$value": "{font.family.display}"
    }
  },
  "page": {
    "bg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1059, 0.1059, 0.1216],
        "hex": "#1b1b1f"
      }
    },
    "fg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8745, 0.8745, 0.8392],
        "hex": "#dfdfd6"
      }
    }
  },
  "palette": {
    "cyan": {
      "300": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4039, 0.9098, 0.9765],
          "hex": "#67e8f9"
        }
      },
      "400": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1333, 0.8275, 0.9333],
          "hex": "#22d3ee"
        }
      }
    },
    "indigo": {
      "300": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.6471, 0.7059, 0.9882],
          "hex": "#a5b4fc"
        }
      },
      "400": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.5059, 0.549, 0.9725],
          "hex": "#818cf8"
        }
      },
      "500": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3882, 0.4, 0.9451],
          "hex": "#6366f1"
        }
      },
      "600": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.3098, 0.2745, 0.898],
          "hex": "#4f46e5"
        }
      }
    },
    "violet": {
      "400": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.6549, 0.5451, 0.9804],
          "hex": "#a78bfa"
        }
      }
    }
  },
  "status": {
    "error": {
      "bg": {
        "$type": "color",
        "$value": {
          "alpha": 0.1607843137254902,
          "colorSpace": "srgb",
          "components": [0.9569, 0.2471, 0.3686],
          "hex": "#f43f5e"
        }
      },
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9647, 0.4353, 0.5059],
          "hex": "#f66f81"
        }
      }
    },
    "success": {
      "bg": {
        "$type": "color",
        "$value": {
          "alpha": 0.1607843137254902,
          "colorSpace": "srgb",
          "components": [0.0627, 0.7255, 0.5059],
          "hex": "#10b981"
        }
      },
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.2392, 0.8392, 0.549],
          "hex": "#3dd68c"
        }
      }
    },
    "warning": {
      "bg": {
        "$type": "color",
        "$value": {
          "alpha": 0.1607843137254902,
          "colorSpace": "srgb",
          "components": [0.9176, 0.702, 0.0314],
          "hex": "#eab308"
        }
      },
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9765, 0.7059, 0.3059],
          "hex": "#f9b44e"
        }
      }
    }
  },
  "surface": {
    "overlay": {
      "bg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1255, 0.1294, 0.1529],
          "hex": "#202127"
        }
      }
    },
    "raised": {
      "bg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.1255, 0.1294, 0.1529],
          "hex": "#202127"
        }
      }
    },
    "sunken": {
      "bg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0863, 0.0863, 0.0941],
          "hex": "#161618"
        }
      }
    }
  },
  "text": {
    "muted": {
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4157, 0.4157, 0.4431],
          "hex": "#6a6a71"
        }
      }
    },
    "primary": {
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8745, 0.8745, 0.8392],
          "hex": "#dfdfd6"
        }
      }
    },
    "secondary": {
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.5961, 0.5961, 0.6235],
          "hex": "#98989f"
        }
      }
    }
  }
}
