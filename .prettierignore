# Research sample-workspace JSON (tsconfig.json, nx.json, turbo.json,
# project.json, …) is kept in the `pretty-format-json` pre-commit hook's
# canonical form (sorted keys, one array element per line). Prettier formats
# JSON arrays the opposite way (collapsed), so the two hooks would fight on
# every commit. Exclude these sample JSON from Prettier and let
# pretty-format-json own them. `package.json` is negated back in: the
# pretty-format-json hook ignores it, so Prettier keeps managing it.
docs/research/monorepo-tooling/*/sample/**/*.json
!docs/research/monorepo-tooling/*/sample/**/package.json

# Benchmark snapshots use pretty-format-json's sorted canonical form.
libs/wired/bench/runtime/results/*.json

# Markdown rendering fixtures are byte-exact test inputs: they deliberately
# exercise syntax variants Prettier normalizes away (`*em*` vs `_em_`, `***`
# rules, setext headings, ragged tables), and the goldens beside them are
# rendered grids Prettier must never touch.
libs/syntax/test/data/**
libs/source-view/test/data/**

# Verbatim examples of the DTCG 2025.10 specification (some carry comments,
# as the specification writes them); the test reads them byte for byte.
libs/ui/test/data/dtcg-2025.10/*.tokens
libs/ui/test/data/themes/*.tokens

# The docs site's design-system properties are generated by
# apps/ci/tools/gen-site-css.d, and a drift test compares them byte for byte
# with a fresh emission (WEB3); a reformat would read as drift.
docs/.vitepress/theme/spk.css
