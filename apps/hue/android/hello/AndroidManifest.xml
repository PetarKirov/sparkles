<?xml version="1.0" encoding="utf-8"?>
<!-- The M1 smoke-test APK (packages.hello-apk): proves the whole risky spine —
    LDC's static druntime inside a .so, raylib's android_main → D main()
    handoff, EGL/GLES2 init, the APK tooling, and 16 KB page alignment —
    before any hue code is involved. Same shape as ../AndroidManifest.xml,
    distinct package id so it can live beside the real app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.sparkles.hue.hello">

    <!-- versionCode/versionName and <uses-sdk> are injected by aapt2 from nix
        (see ../AndroidManifest.xml for why they are not declared here). -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:label="hue hello"
        android:hasCode="false"
        android:allowBackup="false"
        android:extractNativeLibs="true">
        <!-- configChanges deliberately omits orientation|screenSize: the smoke
            test has no state worth preserving across a rotation, so letting the
            activity restart is the simpler behaviour. hue's manifest declares
            them because it carries the raylib in-place-resize patch. -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|density"
            android:screenOrientation="fullUser">
            <meta-data android:name="android.app.lib_name" android:value="hello" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
