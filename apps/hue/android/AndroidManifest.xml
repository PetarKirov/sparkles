<?xml version="1.0" encoding="utf-8"?>
<!-- The hue APK manifest: a pure NativeActivity app — no Java, no DEX
    (hasCode="false"). The framework's android.app.NativeActivity loads
    lib/<abi>/libhue.so (android.app.lib_name) directly; raylib's
    PLATFORM_ANDROID backend inside it provides ANativeActivity_onCreate /
    android_main and calls hue's main().

    Rotation resizes IN PLACE (orientation/screenSize in configChanges): the
    nix raylib-android build carries raylib-android-in-place-resize.patch,
    which teaches raylib's Android backend to refresh its size-derived state
    on WINDOW_RESIZED/CONFIG_CHANGED — hue then reflows through its normal
    resize path with all state (scroll, document, theme) preserved. Stock
    raylib 5.5 cannot do this; without the patch, keep orientation OUT of
    configChanges so a restart re-inits at the new size.

    extractNativeLibs="true": the grammar parser libraries are dlopen'd by
    soname from the app's linker namespace; extracted real files also keep
    ndk-stack symbolization simple. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.sparkles.hue">

    <!-- No <uses-sdk> on purpose: aapt2's min/target-sdk-version flags only
        apply as DEFAULTS when the manifest omits it, so declaring it here would
        shadow them and let the APK claim an API level the native code was not
        built against. nix/packages/android/{ndk,sdk}.nix are the source. -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- android:debuggable is NOT declared here: aapt2's debug-mode flag injects
        it for debug builds (see nix/packages/android/build-apk.nix), so a release
        APK simply does not carry it.

        allowBackup="false": the app's private dir is where the APK's own asset
        bundle is materialized, all of it re-derivable from the APK. Left at the
        default (true) it would be uploaded to the user's Google Drive and
        device-to-device transfers — pointless for the sample build, and for the
        repo-embedded one ~29 MB that silently exceeds Auto Backup's 25 MB quota
        and is dropped anyway. -->
    <application
        android:label="hue"
        android:hasCode="false"
        android:allowBackup="false"
        android:extractNativeLibs="true">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|density"
            android:screenOrientation="fullUser">
            <meta-data android:name="android.app.lib_name" android:value="hue" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
