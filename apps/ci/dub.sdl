name "ci"
description "Repository CI helper for markdown examples, standalone examples, and markdown link maintenance"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetType "executable"
targetName "ci"
targetPath "build"
mainSourceFile "src/ci_main.d"

dflags "-preview=in" "-preview=dip1000"

dependency "sparkles:base" path="../.."
dependency "sparkles:core-cli" path="../.."
dependency "expected" version="~>0.4.1"
dependency "sparkles:wired" path="../.."
// Optimised, assertions live, `debug {}` blocks out — the build every nix
// artifact uses. Neither `debug` (which compiles those blocks in) nor
// `release` (which deletes assert *expressions*, side effects included).
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}

// `app.d` is an ordinary module here (`main` lives in `ci_main.d`), so the test
// build compiles the whole tool — including `ci_stats`' `fromJSON` template
// instantiations. `-allinst` is what makes dmd emit the `JsonDocument`
// instantiations those reference; without it the test binary fails to link
// against `sparkles:wired` on dmd (ldc emits them either way). Same recipe as
// every library package's unittest configuration.
configuration "unittest" {
    dflags "-checkaction=context" "-allinst"
}
