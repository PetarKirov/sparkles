name "diagram"
description "A draw.io-style diagram board on sparkles:ui-app — the abstraction-stress app"
authors "Petar Kirov"
license "BSL-1.0"

targetType "executable"
targetPath "build"

dflags "-preview=in" "-preview=dip1000"

// The whole point (DIA1): the application never names a backend. The host's
// configuration decides which arms exist; nothing here imports ui-tui,
// ui-raylib, raylib, or sparkles.tui — checked by the manual isolation grep
// (DIA2): rg -n "ui_tui|ui_raylib|sparkles\.tui|import raylib" apps/diagram/
dependency "sparkles:base" path="../.."
dependency "sparkles:core-cli" path="../.."
dependency "sparkles:input" path="../.."
dependency "sparkles:ui" path="../.."
dependency "sparkles:ui-app" path="../.."

configuration "application" {
    targetType "executable"
    subConfiguration "sparkles:ui-app" "full"
}

// The terminal-only build (DIA4): proves the app builds and runs where no GPU
// stack exists at all.
configuration "no-gui" {
    targetType "executable"
    subConfiguration "sparkles:ui-app" "tui"
}

configuration "unittest" {
    targetType "library"
    excludedSourceFiles "src/app.d"

    dependency "sparkles:test-runner" path="../.."
    // Scratch-tree fixtures for `grid_file.d`'s save/load round trip. Test
    // helpers, so unittest-only: they must never enter the shipped closure.
    dependency "sparkles:test-utils" path="../.."
    subConfiguration "sparkles:ui-app" "full"

    dflags "-checkaction=context" "-allinst"
}

// BEGIN managed build types — apps/ci/tools/standardize-build-settings.d
buildType "unittest" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-debug" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov" {
    buildOptions "unittests" "coverage" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov-ctfe" {
    buildOptions "unittests" "coverageCTFE" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
buildType "bench" {
    buildOptions "unittests" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-unchecked" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-static" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "--link-defaultlib-shared=false" "--linker=gold" platform="linux-ldc"
    dflags "-defaultlib=libphobos2.a" "-L-fuse-ld=gold" platform="linux-dmd"
    lflags "--export-dynamic" platform="linux-ldc"
}
// END managed build types
