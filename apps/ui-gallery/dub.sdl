name "ui-gallery"
description "A browsable catalog of the sparkles:ui toolkit, in the terminal and in a window"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetType "executable"
targetName "ui-gallery"
targetPath "build"
mainSourceFile "src/app.d"

// The `dumpTree` goldens the catalog sweep compares against.
stringImportPaths "test/data"

dflags "-preview=in" "-preview=dip1000"

dependency "sparkles:ui" path="../.."
// The Property page uses the ui property tree's fuzzy search projection;
// sparkles:ui reaches fuzzy import-only (see libs/ui/dub.sdl), so the
// consumer supplies the linked library.
dependency "sparkles:fuzzy" path="../.."
dependency "sparkles:ui-app" path="../.."
dependency "sparkles:input" path="../.."
dependency "sparkles:core-cli" path="../.."

// The Terminal page embeds real shells — the TVW7 proof. A sourceLibrary: its
// modules compile into this executable (an intermediate static library would
// break the ImportC pkg-config seam).
dependency "sparkles:terminal-view" path="../.."

// `--render` paints through the terminal's OWN canvas, not a lookalike: a
// headless render of a different painter than the one that runs is worse than
// no render at all. `src/render.d` is the one module in this application that
// names a canvas, and it is a development tool rather than the frame path.
dependency "sparkles:ui-tui" path="../.."
dependency "sparkles:tui" path="../.."

// Both arms. The gallery's whole claim is that one `view` serves a terminal and
// a window, so a configuration carrying only one of them would make the claim
// unfalsifiable rather than true.
subConfiguration "sparkles:ui-app" "full"

// `debug` to test, `checked` to ship, never `release`: `-release` deletes an
// assert's whole expression, so a call written inside one silently stops
// happening. See docs/guidelines/AGENTS.md § Build types.

// Explicit, because a package with any `configuration` block loses the implicit
// default one — and with only `unittest` declared, `dub build :ui-gallery`
// would select *it*.
configuration "application" {
    targetType "executable"
}

// The gallery on the native arm: `sparkles:wsi` windows drawn by
// `sparkles:ui-vulkan` (`INT4`'s `gui-vulkan`), beside the terminal.
configuration "vulkan" {
    targetType "executable"
    subConfiguration "sparkles:ui-app" "full-vulkan"
}

// Last in the file and running to EOF: `nix/packages/build-sparkles-app.nix`
// derives this package's source closure by truncating the manifest here.
configuration "unittest" {
    targetType "library"
    excludedSourceFiles "src/app.d"
    dependency "sparkles:test-runner" path="../.."
    // The pages through the Vulkan canvas on a real driver (`vulkan_pages.d`).
    dependency "sparkles:ui-vulkan" path="../.."
    dependency "sparkles:vulkan-wsi" path="../.."
    dflags "-checkaction=context" "-allinst"
}

// BEGIN managed build types — apps/ci/tools/standardize-build-settings.d
dflags "--linker=lld" platform="linux-ldc"
dflags "-L-fuse-ld=lld" platform="linux-dmd"

buildType "unittest" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-debug" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov" {
    buildOptions "unittests" "coverage" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov-ctfe" {
    buildOptions "unittests" "coverageCTFE" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
buildType "bench" {
    buildOptions "unittests" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-unchecked" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-static" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "--link-defaultlib-shared=false" platform="linux-ldc"
    dflags "-defaultlib=libphobos2.a" platform="linux-dmd"
    lflags "--export-dynamic" platform="linux-ldc"
}
// END managed build types
