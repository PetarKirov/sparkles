# The text lab on Android: apps/text-lab on the native `sparkles:wsi` Android
# backend and the Vulkan canvas — the same canvas, settings and loupe as on
# the desktop, on a phone's panel and GPU.
#
#   packages.libtext-lab-android   apps/text-lab as lib<abi>/libtextlab.so
#   packages.text-lab-assets       its fonts, as an extractable asset bundle
#   packages.text-lab-apk          the APK
#   packages.text-lab-apk-debug    the same, under the examples' shared
#                                  `.debug` application id, so a device that
#                                  asks before each new package asks once
#
# The activity is sparkles:wsi's (`AndroidWsiMain` in apps/text-lab/src/app.d),
# so nothing of raylib's `native_app_glue` is linked.
{ inputs, lib, ... }:
let
  androidHost = import ./host.nix { inherit inputs; };
in
{
  perSystem =
    {
      config,
      pkgs,
      system,
      ...
    }:
    let
      ndk = config.legacyPackages.androidNdk;
      sources = config.legacyPackages.sparklesSources;
      fonts = config.legacyPackages.sparklesFonts;

      srcDirs = sources.srcClosure "apps/text-lab";
      # The libraries the closure reaches, by sub-package name: their `Have_*`
      # versions, as dub would set them, are derived rather than listed.
      closure = lib.unique (
        map (dir: builtins.elemAt (lib.splitString "/" dir) 1) (
          builtins.filter (lib.hasPrefix "libs/") srcDirs
        )
      );
      javaName = lib.replaceStrings [ "-" ] [ "_" ];

      library = config.legacyPackages.buildDAndroidLib {
        pname = "libtext-lab-android";
        libName = "textlab";
        mainFile = "apps/text-lab/src/app.d";
        srcDirs = srcDirs ++ [ "libs/android/c" ];
        versions = [
          # The `application` configuration's choices: the native arm, and
          # sparkles:font's HarfBuzz engine (the canvas shapes clusters).
          "UiAppGuiVulkan"
          "SparklesFontEngine"
          "Have_expected"
          "Have_optional"
          "Have_bolts"
        ]
        ++ map (name: "Have_sparkles_${javaName name}") (
          lib.subtractLists [ "test-runner" "test-runner-impl" ] closure
        );
        dubDeps = [
          {
            name = "expected";
            src = inputs.dub-expected;
          }
          # sparkles:wired's.
          {
            name = "optional";
            src = inputs.dub-optional;
          }
          {
            name = "bolts";
            src = inputs.dub-bolts;
          }
        ];
        # The canvas's SPIR-V, prebuilt (`ui-vulkan-shaders`): its
        # `generated/shaders` string imports.
        stringImportDirs = [ "${config.packages.ui-vulkan-shaders}" ];
        staticLibs = abi: [
          "${config.packages.harfbuzz-android}/lib/${abi}/libharfbuzz.a"
          "${config.packages.freetype-android}/lib/${abi}/libfreetype.a"
          "${config.packages.freetype-android}/lib/${abi}/libpng16.a"
          "${config.packages.freetype-android}/lib/${abi}/libz.a"
          "${config.packages.libkqueue-android}/lib/${abi}/libkqueue.a"
        ];
        raylibGlue = false;
        description = "apps/text-lab as an Android shared library, per ABI";
      };

      # The specimen face in its four styles, the icon face, and every script
      # fallback and the emoji the desktop bundle has — so a phone draws what
      # the desktop does, not whatever fonts it ships. `sparkles.android.assets`
      # extracts what `asset-manifest.txt` lists, again when `bundle-hash`
      # changes.
      assets = pkgs.runCommand "text-lab-android-assets" { } ''
        mkdir -p $out/fonts
        for f in DejaVuSansMono.ttf DejaVuSansMono-Bold.ttf DejaVuSansMono-Oblique.ttf \
            DejaVuSansMono-BoldOblique.ttf FiraCodeNerdFontMono-Regular.ttf; do
          cp ${fonts.fontBundle}/fonts/$f ${fonts.fontBundle}/fonts/$f.charset $out/fonts/
        done
        cp ${fonts.fontBundle}/fonts/Noto* $out/fonts/
        rm -f $out/fonts/NotoSansTest.ttf*
        (cd $out && find fonts -type f | sort > asset-manifest.txt)
        (cd $out && find fonts -type f -print0 | sort -z \
          | xargs -0 sha256sum | sha256sum | cut -d' ' -f1 > bundle-hash)
      '';

      apk =
        shared:
        let
          applicationId =
            if shared then "dev.petar_kirov.sparkles.example.debug" else "dev.petar_kirov.sparkles.text_lab";
          manifest = pkgs.writeText "AndroidManifest.xml" ''
            <?xml version="1.0" encoding="utf-8"?>
            <!-- Generated by nix/packages/android/text-lab.nix. -->
            <manifest xmlns:android="http://schemas.android.com/apk/res/android"
                package="${applicationId}">
                <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="true" />
                <application
                    android:label="text lab${lib.optionalString shared " (debug)"}"
                    android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
                    android:hasCode="false"
                    android:allowBackup="false"
                    android:extractNativeLibs="true">
                    <activity
                        android:name="android.app.NativeActivity"
                        android:exported="true"
                        android:launchMode="singleTask"
                        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
                        android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
                        <meta-data android:name="android.app.lib_name" android:value="textlab" />
                        <meta-data android:name="android.app.func_name" android:value="sparkles_wsi_onCreate" />
                        <intent-filter>
                            <action android:name="android.intent.action.MAIN" />
                            <category android:name="android.intent.category.LAUNCHER" />
                        </intent-filter>
                    </activity>
                </application>
            </manifest>
          '';
        in
        config.legacyPackages.buildAndroidApk {
          pname = "text-lab${lib.optionalString shared "-debug"}";
          inherit manifest;
          assetsDir = assets;
          libs = lib.mapAttrs' (_: t: {
            name = t.abi;
            value."libtextlab.so" = "${library}/lib/${t.abi}/libtextlab.so";
          }) ndk.targets;
          targetSdk = 29;
          description = "The text lab, on Android";
        }
        // {
          inherit applicationId;
        };
    in
    lib.optionalAttrs (androidHost system).supported {
      packages = {
        libtext-lab-android = library;
        text-lab-assets = assets;
        text-lab-apk = apk false;
        text-lab-apk-debug = apk true;
      };
    };
}
