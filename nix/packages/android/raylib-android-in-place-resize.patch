+// ANDROID: Refresh every window-size-derived dimension after the native window
+// changed size in place (an orientation change while the activity keeps running,
+// i.e. orientation|screenSize in configChanges). No-op while the size is
+// unchanged. NOTE: Resets any screen-to-display scaling to the native window
+// size (the InitWindow(0, 0) fullscreen case, which is what a rotating app is)
+static void AndroidUpdateWindowSize(struct android_app *app)
+{
+    if ((app->window == NULL) || !CORE.Window.ready) return;
+
+    int32_t width = ANativeWindow_getWidth(app->window);
+    int32_t height = ANativeWindow_getHeight(app->window);
+    if ((width <= 0) || (height <= 0)) return;
+    if ((width == (int32_t)CORE.Window.display.width) &&
+        (height == (int32_t)CORE.Window.display.height)) return;
+
+    CORE.Window.display.width = width;
+    CORE.Window.display.height = height;
+    CORE.Window.screen.width = width;
+    CORE.Window.screen.height = height;
+    CORE.Window.render.width = width;
+    CORE.Window.render.height = height;
+    CORE.Window.currentFbo.width = width;
+    CORE.Window.currentFbo.height = height;
+    CORE.Window.renderOffset.x = 0;
+    CORE.Window.renderOffset.y = 0;
+
+    // 0x0 buffer geometry: the buffers follow the window size from here on
+    EGLint displayFormat = 0;
+    eglGetConfigAttrib(platform.device, platform.config, EGL_NATIVE_VISUAL_ID, &displayFormat);
+    ANativeWindow_setBuffersGeometry(app->window, 0, 0, displayFormat);
+
+    SetupViewport(width, height);
+    CORE.Window.resizedLastFrame = true;
+
+    TRACELOG(LOG_INFO, "ANDROID: Window resized in place: %i x %i", width, height);
+}
+
