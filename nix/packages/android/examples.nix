# `legacyPackages.androidExamples.<lib>.<example>`: an APK for every library
# example whose inline recipe says `platforms "android"`.
#
# Such an example is a single-file dub program like any other (its recipe names
# its `sparkles:*` dependencies), but it runs as a NativeActivity: it mixes in
# `sparkles.wsi.platform.android.AndroidWsiMain`, which defines the activity's
# entry `sparkles_wsi_onCreate`. The desktop example set skips it — no host
# platform token is `android` — and this builds it instead, deriving
# everything from the catalogue `nix/packages/examples.nix` exposes:
#
# - sources: the recipe's `sparkles:*` closure, as `buildSparklesApp` computes
#   it, plus the example's own directory;
# - versions: a `Have_*` per library in that closure (the unittest-only test
#   runner excepted, which code tests for) and `Have_expected`;
# - native libraries: libkqueue when Event Horizon is in the closure (its
#   Android backend);
# - the manifest: generated, with the application id
#   `dev.petar_kirov.sparkles.example.<lib>.<example>` (on the derivation as
#   `applicationId`) and a Vulkan feature requirement when `sparkles:vulkan`
#   is in the closure.
#
# Each APK has a `.debug` variant whose application id,
# `dev.petar_kirov.sparkles.example.debug`, is the same for every example: a
# device that asks before installing a new package asks once for all of them.
# The lane scripts build it when `APK_VARIANT=debug`.
#
# The lane that runs them is libs/wsi/scripts/verify-android-emulator.sh.
{ lib, inputs, ... }:
let
  androidHost = import ./host.nix { inherit inputs; };
in
{
  perSystem =
    {
      config,
      pkgs,
      system,
      ...
    }:
    let
      ndk = config.legacyPackages.androidNdk;
      inherit (config.legacyPackages.exampleCatalog) allExampleFiles exampleInfo;
      inherit (config.legacyPackages.sparklesSources) libsClosure refsIn;

      isAndroidExample = path: builtins.elem "android" (exampleInfo path).platforms;

      # A Java package segment: letters, digits and underscores.
      javaName = lib.replaceStrings [ "-" ] [ "_" ];

      # `shared`: the debug variant, whose application id is one for every
      # example, so a device that asks before each new package (MIUI's "Install
      # via USB") asks once; each install replaces whichever example was there.
      sharedId = "dev.petar_kirov.sparkles.example.debug";

      apkFor =
        shared: path:
        let
          info = exampleInfo path;
          srcDirs = libsClosure (refsIn (builtins.readFile path));
          closure = map (dir: builtins.elemAt (lib.splitString "/" dir) 1) srcDirs;
          has = name: builtins.elem name closure;
          libName = javaName info.fileBase;
          applicationId =
            if shared then sharedId else "dev.petar_kirov.sparkles.example.${javaName info.libName}.${libName}";

          manifest = pkgs.writeText "AndroidManifest.xml" ''
            <?xml version="1.0" encoding="utf-8"?>
            <!-- Generated by nix/packages/android/examples.nix for ${info.examplePathRel}. -->
            <manifest xmlns:android="http://schemas.android.com/apk/res/android"
                package="${applicationId}">
            ${lib.optionalString (has "vulkan") ''
              <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="true" />
            ''}
                <application
                    android:label="sparkles ${info.libName} ${info.fileBase}${lib.optionalString shared " (debug)"}"
                    android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
                    android:hasCode="false"
                    android:allowBackup="false"
                    android:extractNativeLibs="true">
                    <activity
                        android:name="android.app.NativeActivity"
                        android:exported="true"
                        android:launchMode="singleTask"
                        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
                        android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
                        <meta-data android:name="android.app.lib_name" android:value="${libName}" />
                        <meta-data android:name="android.app.func_name" android:value="sparkles_wsi_onCreate" />
                        <intent-filter>
                            <action android:name="android.intent.action.MAIN" />
                            <category android:name="android.intent.category.LAUNCHER" />
                        </intent-filter>
                    </activity>
                </application>
            </manifest>
          '';

          nativeLib = config.legacyPackages.buildDAndroidLib {
            pname = "lib${libName}-android";
            inherit libName;
            mainFile = info.examplePathRel;
            srcDirs = srcDirs ++ [
              "libs/android/c"
              info.parentDirRel
            ];
            # String imports any library in the closure makes, such as the
            # prebuilt SPIR-V of `sparkles:vulkan-wsi`.
            stringImportDirs = lib.optional (has "vulkan-wsi") "libs/vulkan-wsi/src/shaders";
            staticLibs =
              abi:
              lib.optional (has "event-horizon") "${config.packages.libkqueue-android}/lib/${abi}/libkqueue.a";
            raylibGlue = false;
            versions = [
              "Have_expected"
            ]
            ++ map (name: "Have_sparkles_${javaName name}") (
              lib.subtractLists [ "test-runner" "test-runner-impl" ] closure
            );
            dubDeps = [
              {
                name = "expected";
                src = inputs.dub-expected;
              }
            ];
            description = "${info.examplePathRel} as an Android shared library";
          };
        in
        config.legacyPackages.buildAndroidApk {
          pname = "${info.libName}-example-${info.fileBase}${lib.optionalString shared "-debug"}";
          inherit manifest;
          libs = lib.mapAttrs' (_: t: {
            name = t.abi;
            value."lib${libName}.so" = "${nativeLib}/lib/${t.abi}/lib${libName}.so";
          }) ndk.targets;
          targetSdk = 29;
          description = "Android example: ${info.examplePathRel}";
        }
        // {
          inherit applicationId;
        };
    in
    lib.optionalAttrs (androidHost system).supported {
      legacyPackages.androidExamples = lib.pipe (builtins.filter isAndroidExample allExampleFiles) [
        (lib.groupBy (path: (exampleInfo path).libName))
        (lib.mapAttrs (
          _: paths:
          lib.listToAttrs (
            map (path: {
              name = (exampleInfo path).fileBase;
              value = apkFor false path // {
                debug = apkFor true path;
              };
            }) paths
          )
        ))
      ];
    };
}
