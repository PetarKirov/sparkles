# The editor on Android: apps/editor on the native `sparkles:wsi` Android
# backend and the Vulkan canvas — the same tabs, palette, layout-backed field
# and recovery as on the desktop.
#
#   packages.libeditor-android   apps/editor as lib<abi>/libeditor.so
#   packages.editor-assets       its fonts, as an extractable asset bundle
#   packages.editor-apk          the APK, debuggable and signed with the in-tree
#                                debug key like every development APK here
#   packages.editor-apk-debug    the same, under the examples' shared `.debug`
#                                application id, so a device that asks before
#                                each new package asks once
#
# The activity is sparkles:wsi's (`AndroidWsiMain`, mixed in by
# apps/editor/src/android_entry.d), so nothing of raylib's `native_app_glue`
# is linked. System document access (open-with, providers) is not declared
# yet: EAP23's provider adapter is separate delivery work.
{ inputs, lib, ... }:
let
  androidHost = import ./host.nix { inherit inputs; };
in
{
  perSystem =
    {
      config,
      pkgs,
      system,
      ...
    }:
    let
      ndk = config.legacyPackages.androidNdk;
      fonts = config.legacyPackages.sparklesFonts;

      # dub builds the editor for Android from its recipes (`android` configuration).
      library = config.legacyPackages.buildSparklesAndroidLib {
        pname = "libeditor-android";
        appDir = "apps/editor";
        libName = "editor";
        inherit ((androidHost system)) ldcAndroid;
      };

      # The document face and the script fallbacks and emoji the desktop
      # bundle has, so the device draws the editor's Unicode examples as the
      # desktop does. `sparkles.android.assets` extracts what
      # `asset-manifest.txt` lists, again when `bundle-hash` changes.
      assets = pkgs.runCommand "editor-android-assets" { } ''
        mkdir -p $out/fonts
        for f in DejaVuSansMono.ttf DejaVuSansMono-Bold.ttf DejaVuSansMono-Oblique.ttf \
            DejaVuSansMono-BoldOblique.ttf; do
          cp ${fonts.fontBundle}/fonts/$f ${fonts.fontBundle}/fonts/$f.charset $out/fonts/
        done
        cp ${fonts.fontBundle}/fonts/Noto* $out/fonts/
        rm -f $out/fonts/NotoSansTest.ttf*
        (cd $out && find fonts -type f | sort > asset-manifest.txt)
        (cd $out && find fonts -type f -print0 | sort -z \
          | xargs -0 sha256sum | sha256sum | cut -d' ' -f1 > bundle-hash)
      '';

      apk =
        shared:
        let
          applicationId =
            if shared then "dev.petar_kirov.sparkles.example.debug" else "dev.petar_kirov.sparkles.editor";
          manifest = pkgs.writeText "AndroidManifest.xml" ''
            <?xml version="1.0" encoding="utf-8"?>
            <!-- Generated by nix/packages/android/editor.nix. -->
            <manifest xmlns:android="http://schemas.android.com/apk/res/android"
                package="${applicationId}">
                <uses-feature android:name="android.hardware.vulkan.version" android:version="0x400003" android:required="true" />
                <application
                    android:label="Sparkles Editor${lib.optionalString shared " (debug)"}"
                    android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
                    android:hasCode="false"
                    android:allowBackup="false"
                    android:extractNativeLibs="true">
                    <activity
                        android:name="android.app.NativeActivity"
                        android:exported="true"
                        android:launchMode="singleTask"
                        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
                        android:windowSoftInputMode="adjustResize|stateHidden">
                        <meta-data android:name="android.app.lib_name" android:value="editor" />
                        <meta-data android:name="android.app.func_name" android:value="sparkles_wsi_onCreate" />
                        <intent-filter>
                            <action android:name="android.intent.action.MAIN" />
                            <category android:name="android.intent.category.LAUNCHER" />
                        </intent-filter>
                    </activity>
                </application>
            </manifest>
          '';
        in
        config.legacyPackages.buildAndroidApk {
          pname = "editor${lib.optionalString shared "-debug"}";
          inherit manifest;
          assetsDir = assets;
          libs = lib.mapAttrs' (_: t: {
            name = t.abi;
            value."libeditor.so" = "${library}/lib/${t.abi}/libeditor.so";
          }) ndk.targets;
          targetSdk = 29;
          description = "The Sparkles editor, on Android";
        }
        // {
          inherit applicationId;
        };
    in
    lib.optionalAttrs (androidHost system).supported {
      androidPackages = {
        libeditor-android = library;
        editor-assets = assets;
        editor-apk = apk false;
        editor-apk-debug = apk true;
      };
    };
}
