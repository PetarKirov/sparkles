          "type": "STRING",
          "value": "-"
        },
        {
          "type": "FIELD",
          "name": "right",
          "content": {
            "type": "SYMBOL",
            "name": "_term"
          }
        }
      ]
    },
    "_term": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "intersection"
        },
        {
          "type": "SYMBOL",
          "name": "_unary"
        }
      ]
    },
    "intersection": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "left",
          "content": {
            "type": "SYMBOL",
            "name": "_term"
          }
        },
        {
          "type": "STRING",
          "value": "&"
        },
        {
          "type": "FIELD",
          "name": "right",
          "content": {
            "type": "SYMBOL",
            "name": "_unary"
          }
        }
      ]
    },
    "_unary": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "parenthesized"
        },
        {
          "type": "SYMBOL",
          "name": "call"
        },
        {
          "type": "SYMBOL",
          "name": "nullary"
        },
        {
          "type": "SYMBOL",
          "name": "file_filter"
        },
        {
          "type": "SYMBOL",
          "name": "path"
        }
