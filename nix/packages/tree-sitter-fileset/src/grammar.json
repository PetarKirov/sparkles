{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/grammar.schema.json",
  "name": "fileset",
  "word": "glob",
  "rules": {
    "query": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "_expression"
        },
        {
          "type": "BLANK"
        }
      ]
    },
    "_expression": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "union"
        },
        {
          "type": "SYMBOL",
          "name": "difference"
        },
        {
          "type": "SYMBOL",
          "name": "intersection"
        },
        {
          "type": "SYMBOL",
          "name": "_unary"
        }
      ]
    },
    "union": {
      "type": "PREC_LEFT",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "left",
            "content": {
              "type": "SYMBOL",
              "name": "_expression"
            }
          },
          {
            "type": "STRING",
            "value": "|"
          },
          {
            "type": "FIELD",
            "name": "right",
            "content": {
              "type": "SYMBOL",
              "name": "_expression"
            }
          }
        ]
      }
    },
    "difference": {
      "type": "PREC_LEFT",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "left",
            "content": {
              "type": "SYMBOL",
              "name": "_expression"
            }
          },
          {
            "type": "STRING",
            "value": "-"
          },
          {
            "type": "FIELD",
            "name": "right",
            "content": {
              "type": "SYMBOL",
              "name": "_expression"
            }
          }
        ]
      }
    },
    "intersection": {
      "type": "PREC_LEFT",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "FIELD",
            "name": "left",
            "content": {
              "type": "SYMBOL",
              "name": "_expression"
            }
          },
          {
            "type": "STRING",
            "value": "&"
          },
          {
            "type": "FIELD",
            "name": "right",
            "content": {
              "type": "SYMBOL",
              "name": "_expression"
            }
          }
        ]
      }
    },
    "_unary": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "parenthesized"
        },
        {
          "type": "SYMBOL",
          "name": "call"
        },
        {
          "type": "SYMBOL",
          "name": "file_filter"
        },
        {
          "type": "SYMBOL",
          "name": "keyword"
        },
        {
          "type": "SYMBOL",
          "name": "glob"
        },
        {
          "type": "SYMBOL",
          "name": "string"
        }
      ]
    },
    "parenthesized": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "_expression"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "call": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "function",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "STRING",
                  "value": "unions"
                },
                {
                  "type": "STRING",
                  "value": "intersection"
                },
                {
                  "type": "STRING",
                  "value": "difference"
                }
              ]
            },
            "named": true,
            "value": "function"
          }
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "_expression"
        },
        {
          "type": "REPEAT",
          "content": {
            "type": "SEQ",
            "members": [
              {
                "type": "STRING",
                "value": ","
              },
              {
                "type": "SYMBOL",
                "name": "_expression"
              }
            ]
          }
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "file_filter": {
      "type": "SEQ",
      "members": [
        {
          "type": "FIELD",
          "name": "function",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "STRING",
              "value": "fileFilter"
            },
            "named": true,
            "value": "function"
          }
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "_predicate"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "_predicate": {
      "type": "CHOICE",
      "members": [
        {
          "type": "SYMBOL",
          "name": "or"
        },
        {
          "type": "SYMBOL",
          "name": "and"
        },
        {
          "type": "SYMBOL",
          "name": "not"
        },
        {
          "type": "SYMBOL",
          "name": "has_ext"
        },
        {
          "type": "SYMBOL",
          "name": "name_is"
        },
        {
          "type": "SYMBOL",
          "name": "type_is"
        },
        {
          "type": "SYMBOL",
          "name": "predicate_group"
        }
      ]
    },
    "or": {
      "type": "PREC_LEFT",
      "value": 1,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_predicate"
          },
          {
            "type": "STRING",
            "value": "||"
          },
          {
            "type": "SYMBOL",
            "name": "_predicate"
          }
        ]
      }
    },
    "and": {
      "type": "PREC_LEFT",
      "value": 2,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "SYMBOL",
            "name": "_predicate"
          },
          {
            "type": "STRING",
            "value": "&&"
          },
          {
            "type": "SYMBOL",
            "name": "_predicate"
          }
        ]
      }
    },
    "not": {
      "type": "PREC",
      "value": 3,
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "!"
          },
          {
            "type": "SYMBOL",
            "name": "_predicate"
          }
        ]
      }
    },
    "predicate_group": {
      "type": "SEQ",
      "members": [
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "_predicate"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "has_ext": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "hasExt"
          },
          "named": true,
          "value": "function"
        },
        {
          "type": "STRING",
          "value": "("
        },
        {
          "type": "SYMBOL",
          "name": "string"
        },
        {
          "type": "STRING",
          "value": ")"
        }
      ]
    },
    "name_is": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "name"
          },
          "named": true,
          "value": "predicate"
        },
        {
          "type": "STRING",
          "value": "=="
        },
        {
          "type": "SYMBOL",
          "name": "string"
        }
      ]
    },
    "type_is": {
      "type": "SEQ",
      "members": [
        {
          "type": "ALIAS",
          "content": {
            "type": "STRING",
            "value": "type"
          },
          "named": true,
          "value": "predicate"
        },
        {
          "type": "STRING",
          "value": "=="
        },
        {
          "type": "SYMBOL",
          "name": "string"
        }
      ]
    },
    "keyword": {
      "type": "CHOICE",
      "members": [
        {
          "type": "STRING",
          "value": "all"
        },
        {
          "type": "STRING",
          "value": "none"
        },
        {
          "type": "STRING",
          "value": "exec"
        },
        {
          "type": "STRING",
          "value": "gitignored"
        },
        {
          "type": "STRING",
          "value": "gitTracked"
        }
      ]
    },
    "glob": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "CHOICE",
            "members": [
              {
                "type": "PATTERN",
                "value": "[^\\s()\",#!{\\\\]"
              },
              {
                "type": "PATTERN",
                "value": "\\\\."
              },
              {
                "type": "SEQ",
                "members": [
                  {
                    "type": "STRING",
                    "value": "{"
                  },
                  {
                    "type": "REPEAT",
                    "content": {
                      "type": "CHOICE",
                      "members": [
                        {
                          "type": "PATTERN",
                          "value": "[^\\s()\"{}\\\\]"
                        },
                        {
                          "type": "PATTERN",
                          "value": "\\\\."
                        },
                        {
                          "type": "PATTERN",
                          "value": "\\{[^\\s()\"{}]*\\}"
                        }
                      ]
                    }
                  },
                  {
                    "type": "STRING",
                    "value": "}"
                  }
                ]
              }
            ]
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^\\s()\",{\\\\]"
                },
                {
                  "type": "PATTERN",
                  "value": "\\\\."
                },
                {
                  "type": "SEQ",
                  "members": [
                    {
                      "type": "STRING",
                      "value": "{"
                    },
                    {
                      "type": "REPEAT",
                      "content": {
                        "type": "CHOICE",
                        "members": [
                          {
                            "type": "PATTERN",
                            "value": "[^\\s()\"{}\\\\]"
                          },
                          {
                            "type": "PATTERN",
                            "value": "\\\\."
                          },
                          {
                            "type": "PATTERN",
                            "value": "\\{[^\\s()\"{}]*\\}"
                          }
                        ]
                      }
                    },
                    {
                      "type": "STRING",
                      "value": "}"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "\""
          },
          {
            "type": "REPEAT",
            "content": {
              "type": "CHOICE",
              "members": [
                {
                  "type": "PATTERN",
                  "value": "[^\"\\\\]"
                },
                {
                  "type": "PATTERN",
                  "value": "\\\\."
                }
              ]
            }
          },
          {
            "type": "STRING",
            "value": "\""
          }
        ]
      }
    },
    "comment": {
      "type": "TOKEN",
      "content": {
        "type": "SEQ",
        "members": [
          {
            "type": "STRING",
            "value": "#"
          },
          {
            "type": "PATTERN",
            "value": "[^\\n]*"
          }
        ]
      }
    }
  },
  "extras": [
    {
      "type": "PATTERN",
      "value": "\\s"
    },
    {
      "type": "SYMBOL",
      "name": "comment"
    }
  ],
  "conflicts": [],
  "precedences": [],
  "externals": [],
  "inline": [],
  "supertypes": [],
  "reserved": {}
}
