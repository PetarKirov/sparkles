          },
          "named": true,
          "value": "meta"
        },
        {
          "type": "ALIAS",
          "content": {
            "type": "TOKEN",
            "content": {
              "type": "PATTERN",
              "value": "\\[[!^]?([^\\s()\",\\]\\\\]|\\\\[^\\s])+\\]"
