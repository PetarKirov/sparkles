                  "type": "STRING",
                  "value": "all"
                },
                {
                  "type": "STRING",
                  "value": "none"
                },
                {
                  "type": "STRING",
                  "value": "exec"
                },
                {
                  "type": "STRING",
                  "value": "gitignored"
                },
                {
                  "type": "STRING",
                  "value": "gitTracked"
                }
              ]
            },
            "named": true,
            "value": "function"
