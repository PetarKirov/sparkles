name "wsi"
description "Native desktop window-system integration over sparkles:event-horizon"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetPath "../../build"
targetType "library"

dflags "-preview=in" "-preview=dip1000"
libs "imm32" platform="windows"
lflags "-framework" "AppKit" "-framework" "CoreFoundation" "-framework" "UniformTypeIdentifiers" platform="osx"

// `sparkles:math` is source-imported for the same reason as input: its
// unittest configuration depends on the repository runner and a normal dub
// edge would participate in configuration-union cycle detection.
importPaths "src" "../math/src"
sourcePaths "src"

dependency "expected" version="~>0.4.1"
dependency "sparkles:base" path="../.."
dependency "sparkles:input" path="../.."
dependency "sparkles:event-horizon" path="../.."
// JNI and the activity on Android; every module there is `version (Android)`,
// so on a desktop host this dependency compiles to nothing.
dependency "sparkles:android" path="../.."

// Android is `linux` to dub as to D, and has neither X11 nor Wayland: its
// configuration, first so dub picks it there and only there, leaves their
// backends, C glue and libraries out. The desktop configurations carry them.
configuration "android" {
    platforms "android"
    targetType "library"
    excludedSourceFiles "src/sparkles/wsi/platform/x11.d" "src/sparkles/wsi/platform/wayland.d" "src/*.c"
}

configuration "library" {
    targetType "library"
    libs "wayland-client" "xcb" "xcb-xkb" "xcb-xtest" "xcb-xinput" "xcb-xfixes" "xcb-imdkit" "xkbcommon" "xkbcommon-x11" platform="linux"
    sourceFiles "src/xcb_native.c" platform="linux"
    sourceFiles "src/wayland_native.c" platform="linux"
}

configuration "unittest" {
    libs "wayland-client" "xcb" "xcb-xkb" "xcb-xtest" "xcb-xinput" "xcb-xfixes" "xcb-imdkit" "xkbcommon" "xkbcommon-x11" platform="linux"
    sourceFiles "src/xcb_native.c" platform="linux"
    sourceFiles "src/wayland_native.c" platform="linux"
    dependency "sparkles:test-runner" path="../.."

    dflags "-checkaction=context" "-allinst"
}

// BEGIN managed build types — apps/ci/tools/standardize-build-settings.d
dflags "--linker=lld" platform="linux-ldc"
dflags "-L-fuse-ld=lld" platform="linux-dmd"

buildType "unittest" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-debug" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov" {
    buildOptions "unittests" "coverage" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov-ctfe" {
    buildOptions "unittests" "coverageCTFE" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
buildType "bench" {
    buildOptions "unittests" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-unchecked" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-static" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "--link-defaultlib-shared=false" platform="linux-ldc"
    dflags "-defaultlib=libphobos2.a" platform="linux-dmd"
    lflags "--export-dynamic" platform="linux-ldc"
}
// END managed build types
