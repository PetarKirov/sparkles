// ci: run --help
/**
Interactive `sparkles:wsi` event echo — the UAT program for the native
window stack. Opens one window on the platform's native backend (`--window-system`: by
default Wayland where a compositor answers, X11 otherwise, AppKit on macOS)
and logs every event the backend queues, then their counts by kind.

Things to try:
$(LIST
    * hold a key — `repeat` actions (client-synthesized on Wayland);
    * type through your IME — `TextCommitted` and `Composition` lines
        (text-input-v3 on a v3 compositor such as Mutter; XIM through
        `$XMODIFIERS` on X11; `NSTextInputClient` on macOS);
    * scroll, click, and drag — pointer and scroll lines with the shared
        sign convention;
    * drag near a window edge on Wayland — the compositor takes over as an
        interactive resize (GNOME draws no server decorations, so this is
        the only way a bare toplevel resizes there); hold Alt and drag
        anywhere to move the window;
    * press `c` to cycle the standard cursor shapes, `m` to toggle
        maximize, `g` to cycle the pointer capture mode (none, capture,
        confine — move the pointer past the border to see the difference;
        under Xwayland the compositor routes no motion over non-X surfaces
        to a grab and drops the confine-time warp, so start inside), `r`
        to toggle relative motion (`relativePointer` events beside the
        absolute ones), `q` to quit;
    * filter events with `-F "!pointer"`, `-F "pointer.phase == pressed"`, or
        `-F ?` for the schema-generated path and category tables.
)
*/
module wsi_input_echo;

import core.lifetime : move;
import core.time : Duration, msecs;
import std.conv : text;
import std.stdio : writeln;
import std.traits : EnumMembers;

import sparkles.base.expected : Expected, err, ok;

import sparkles.base.logger : LogLevel, error, info, trace, warning;
import sparkles.base.prettyprint : PrettyPrintOptions, prettyPrint;
import sparkles.core_cli.args;
import sparkles.dql : DqlEngine, DqlFilter, DqlSchema, evalDql, parseDql,
    printDqlHelp;
import sparkles.event_horizon.loop : DefaultLoop, LoopConfig;
import sparkles.input.events : KeyAction, PointerButton;
import sparkles.input.pointer : PointerShape;
import sparkles.wsi;

/// How close to a border a press must land to count as a resize grip.
private enum double gripSize = 16;

/// The filtering schema over the WSI event vocabulary, generated by the
/// reflection kernel — the example writes no paths of its own, so `-F ?`
/// can never drift from what the backends actually queue.
alias EventSchema = DqlSchema!WindowEvent;

/// A compiled `-F` filter and the engine that evaluates it; inactive when
/// no filter was given, so every event is logged.
private struct EventFilter
{
    DqlEngine engine;
    DqlFilter filter;
    bool active;

    bool matches(in WindowEvent event)
        => !active || evalDql!EventSchema(engine, filter, event);
}

int main(string[] args) => runCli!WsiInputEcho(args);

@(Command("wsi-input-echo",
    shortDescription: "Interactive native WSI event echo and input test harness",
    description: "Opens a native window on Wayland, X11, or AppKit and logs queued WSI events.",
))
struct WsiInputEcho
{
    @(Option(`W|width`, description: "Window width in logical units"))
    int width = 720;

    @(Option(`H|height`, description: "Window height in logical units"))
    int height = 420;

    @(Option(`f|frames`,
        description: "Process N loop ticks then exit (0 = run until the window closes)"))
    int frames;

    @(Option("window-system", description:
        "Native window system: auto (Wayland where a compositor answers, else X11), wayland, x11, win32, appkit or android"))
    BackendPreference windowSystem = BackendPreference.automatic;

    @(Option(`F|event-filter`,
        description: "DQL event filter, or '?' for the generated schema (e.g. '!pointer', 'keyboard || textCommitted', 'pointer.phase == pressed')"))
    string eventFilter;

    @(Option("no-color", description: "Disable colored output"))
    bool noColor;

    @(Option("log-level", description: "Log level: trace | info | warning | error | critical | off"))
    LogLevel logLevel = LogLevel.info;

    RunExpected!void run() @system => echo(this);
}

private RunExpected!void echo(in WsiInputEcho options) @system
{
    EventFilter filter;
    if (options.eventFilter.length)
    {
        if (options.eventFilter == "?" || options.eventFilter == "help")
        {
            printDqlHelp!EventSchema("wsi-input-echo", !options.noColor);
            return ranOk();
        }
        auto compiled = parseDql!EventSchema(filter.engine, options.eventFilter);
        if (compiled.hasError)
            return failRun("event filter error: " ~ compiled.error.message);
        filter.filter = compiled.value.move;
        filter.active = true;
    }

    DefaultLoop loop;
    if (DefaultLoop.create(loop, LoopConfig()).hasError)
        return failRun("failed to create Event Horizon loop");

    auto report = err!RunReport("no window system ran");
    const opened = openNative!((ref wsi) {
        report = runBackend(wsi, loop, options, filter);
    })(loop, options.windowSystem);
    if (opened.hasError)
    {
        const diagnostic = opened.error.diagnostic[].idup;
        return opened.error.kind == WsiErrorKind.unavailable
            ? skipRun(text(opened.error.backend, " unavailable"), diagnostic)
            : failRun(text(opened.error.backend, " open failed: ", diagnostic));
    }
    if (report.hasError)
        return failRun(report.error);
    writeln(prettyPrint(report.value, PrettyPrintOptions!void(
        colored: !options.noColor,
        softMaxWidth: 100,
    )));
    return ranOk();
}

/// What the run actually did, so an invocation is verifiable.
struct RunReport
{
    BackendKind backend;
    EventStats events; /// every event the backend queued, by kind
    uint eventsLogged; /// those the filter let through
    uint repaints;
    string exitedBecause;
}

private struct EchoState
{
    WindowId id;
    SurfaceMetrics metrics;
    size_t cursorIndex;
    PointerCaptureMode captureMode;
    bool relative;
    bool repaint;
    bool quit;
}

private Expected!(void, string) echoLoop(Backend)(ref Backend wsi, ref DefaultLoop loop,
    ref EchoState state, ref RunReport report, int frameBudget,
    ref EventFilter filter, in PrettyPrintOptions!void opt)
{
    // Inside the drain: count, filter and log, reading text while its
    // `TextId` is live (`ED8`); what acts on the window waits in `batch`
    // until the drain returns.
    WindowEvent[128] batch;
    size_t batched;
    void defer(in WindowEvent event)
    {
        if (batched < batch.length)
            batch[batched++] = event;
    }

    void handle(WindowEvent event)
    {
        report.events.count(event);

        if (!filter.matches(event))
            return;

        report.eventsLogged++;
        // Inside the drain, so the line can quote the event's text (`ED8`).
        info(i"$(eventLine(wsi, event, opt))");
        event.payload.match!(
            (in ReadyEvent value) {
                state.metrics = value.metrics;
                state.repaint = true;
            },
            (in SurfaceMetricsChangedEvent value) {
                state.metrics = value.metrics;
                state.repaint = true;
            },
            (in KeyboardEvent value) {
                if (value.action == KeyAction.release
                    && value.logical.kind == LogicalKeyKind.character)
                    defer(event);
            },
            (in PointerEvent value) {
                if (value.phase == PointerPhase.pressed
                    && value.button == PointerButton.left)
                    defer(event);
            },
            (in CloseRequestedEvent _) {
                info(i"close requested — quitting");
                state.quit = true;
                report.exitedBecause = "window closed";
            },
            (in DestroyedEvent _) {
                state.quit = true;
                report.exitedBecause = "destroyed";
            },
            (_) {});
    }

    // What a deferred event asks of the window, once the drain is over.
    void act(in WindowEvent event)
    {
        event.payload.match!(
            (in KeyboardEvent value) {
                handleCommand(wsi, state, value.logical.character, opt);
            },
            (in PointerEvent value) { handleLeftPress(wsi, state, value); },
            (_) {});
    }

    int loopsRun;
    while (!state.quit && (frameBudget == 0 || loopsRun < frameBudget))
    {
        loopsRun++;
        auto ticked = tickNative(wsi, loop, 250.msecs);
        if (ticked.hasError)
        {
            error(i"loop error: $(ticked.error.context) (errno=$(ticked.error.code) stage=$(ticked.error.stage))");
            auto sticky = wsi.drain((WindowEvent _) @safe {});
            if (sticky.hasError)
                error(i"backend diagnostic: $(sticky.error.diagnostic[]) (kind=$(sticky.error.kind) native=$(sticky.error.nativeCode))");
            return err!void("loop error");
        }
        batched = 0;
        auto drained = wsi.drain((WindowEvent event) @safe {
            () @trusted { handle(event); }();
        });
        if (drained.hasError)
        {
            error(i"event queue error: $(drained.error.diagnostic[])");
            return err!void(cast(string) drained.error.diagnostic[]);
        }
        foreach (ref event; batch[0 .. batched])
            act(event);
        if (state.repaint)
        {
            state.repaint = false;
            report.repaints++;
            paintIfNeeded(wsi, state);
        }
    }
    if (frameBudget > 0 && loopsRun >= frameBudget && !state.quit)
        report.exitedBecause = "frame budget reached";
    return ok();
}

private void handleCommand(Backend)(ref Backend wsi, ref EchoState state,
    dchar command, in PrettyPrintOptions!void opt)
{
    switch (command)
    {
        case 'q':
            info(i"command: quit");
            state.quit = true;
            break;
        case 'c':
            static immutable shapes = [EnumMembers!PointerShape];
            state.cursorIndex = (state.cursorIndex + 1) % shapes.length;
            const shape = shapes[state.cursorIndex];
            auto set = wsi.setCursor(state.id, shape);
            if (set.hasError)
                warning(i"setCursor($(shape)): $(set.error.diagnostic[])");
            else
                info(i"setCursor($(shape)): ok");
            break;
        case 'g':
            static if (is(typeof(wsi.setPointerCapture(state.id,
                    PointerCaptureMode.init))))
            {
                static immutable modes = [EnumMembers!PointerCaptureMode];
                const next = modes[(state.captureMode + 1) % modes.length];
                auto result = wsi.setPointerCapture(state.id, next);
                if (result.hasError)
                    warning(i"setPointerCapture($(next)): $(result.error.diagnostic[])");
                else
                {
                    state.captureMode = next;
                    info(i"setPointerCapture($(next)): ok");
                }
            }
            else
                info(i"setPointerCapture: not available on this backend");
            break;
        case 'r':
            static if (is(typeof(wsi.setRelativePointer(state.id, true))))
            {
                const next = !state.relative;
                auto result = wsi.setRelativePointer(state.id, next);
                if (result.hasError)
                    warning(i"setRelativePointer($(next)): $(result.error.diagnostic[])");
                else
                {
                    state.relative = next;
                    info(i"setRelativePointer($(next)): ok");
                }
            }
            else
                info(i"setRelativePointer: not available on this backend");
            break;
        case 'm':
            static if (is(typeof(wsi.setMaximized(state.id, true))))
            {
                static bool maximized;
                maximized = !maximized;
                auto result = wsi.setMaximized(state.id, maximized);
                if (result.hasError)
                    warning(i"setMaximized($(maximized)): $(result.error.diagnostic[])");
                else
                    info(i"setMaximized($(maximized)): ok");
            }
            else
                info(i"setMaximized: not available on this backend");
            break;
        default:
            break;
    }
}

private void handleLeftPress(Backend)(ref Backend wsi, ref EchoState state,
    in PointerEvent value)
{
    static if (is(typeof(wsi.startInteractiveResize(state.id,
        ResizeEdge.none))))
    {
        if (value.modifiers.alt)
        {
            auto moved = wsi.startInteractiveMove(state.id);
            if (moved.hasError)
                warning(i"startInteractiveMove: $(moved.error.diagnostic[])");
            else
                info(i"startInteractiveMove: ok");
            return;
        }
        const edge = resizeEdgeAt(state.metrics, value.logicalPosition.x,
            value.logicalPosition.y);
        if (edge == ResizeEdge.none)
            return;
        auto resized = wsi.startInteractiveResize(state.id, edge);
        if (resized.hasError)
            warning(i"startInteractiveResize($(edge)): $(resized.error.diagnostic[])");
        else
            info(i"startInteractiveResize($(edge)): ok");
    }
}

// Painting exists only where an unmapped surface would stay invisible:
// a Wayland toplevel maps when a buffer is committed, while X11 windows
// paint their background pixel and AppKit windows draw their own chrome.
version (linux)
{
    import sparkles.wsi.platform.wayland_shm : ShmPainter;

    private ShmPainter painter;

    // A flat color with brighter `gripSize` borders — the visible affordance
    // for the compositor-resize zones.
    private void paintGrips(uint[] pixels, int width, int height)
    {
        foreach (y; 0 .. height)
            foreach (x; 0 .. width)
            {
                const grip = x < gripSize || y < gripSize
                    || x >= width - gripSize || y >= height - gripSize;
                pixels[y * width + x] = grip ? 0xFF3A6EA5 : 0xFF20242C;
            }
    }

    private void paintIfNeeded(Backend)(ref Backend wsi, ref EchoState state)
    {
        static if (is(Backend == WaylandWsi))
        {
            if (!state.metrics.suspended)
                painter.paint!paintGrips(wsi, state.id,
                    cast(int) state.metrics.logicalSize.width,
                    cast(int) state.metrics.logicalSize.height);
        }
    }
}
else
{
    private void paintIfNeeded(Backend)(ref Backend, ref EchoState)
    {
    }
}

private Expected!(RunReport, string) runBackend(Backend)(ref Backend wsi, ref DefaultLoop loop,
    in WsiInputEcho options, ref EventFilter filter)
{
    auto opt = PrettyPrintOptions!void(
        colored: !options.noColor,
        softMaxWidth: 100,
    );

    WindowConfig config;
    if (!config.title.assign("sparkles wsi-input-echo"))
        return err!RunReport("failed to set window title");
    config.logicalSize = LogicalSize(options.width, options.height);

    info(i"creating window with config: $(prettyPrint(config, opt))");
    auto created = wsi.createWindow(config);
    if (created.hasError)
        return err!RunReport("createWindow failed: " ~ cast(string) created.error.diagnostic[]);

    EchoState state;
    state.id = created.value;
    RunReport report = {
        backend: backendKindOf!Backend,
        exitedBecause: "window closed",
    };

    info(i"wsi-input-echo on $(report.backend) — hold keys, type through your IME, scroll, drag the blue border to resize, alt+drag to move, c cycles cursors, m toggles maximize, g cycles pointer capture, r toggles relative motion, q quits");

    // Drain the ready event before the first paint so metrics are real.
    auto drained = wsi.drain((WindowEvent event) @safe {
        report.events.count(event);
        event.payload.match!(
            (in ReadyEvent value) { state.metrics = value.metrics; },
            (_) {});
    });
    if (drained.hasError)
        return err!RunReport("drain error: " ~ cast(string) drained.error.diagnostic[]);

    // On Wayland the ready event follows the first configure, later in the
    // loop; painting waits for real metrics either way.
    if (!state.metrics.suspended)
        paintIfNeeded(wsi, state);

    auto result = echoLoop(wsi, loop, state, report, options.frames, filter, opt);
    if (result.hasError)
        return err!RunReport(result.error);

    return ok(report);
}
