<?xml version="1.0" encoding="utf-8"?>
<!-- The sparkles:wsi Android smoke (legacyPackages.wsi-android-smoke-apk): the
    native backend owns the activity, with no raylib glue, so the manifest
    names its entry, sparkles_wsi_onCreate, as android.app.func_name. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.petar_kirov.sparkles.wsismoke">

    <application
        android:label="sparkles wsi smoke"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:hasCode="false"
        android:allowBackup="false"
        android:extractNativeLibs="true">
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <meta-data android:name="android.app.lib_name" android:value="wsismoke" />
            <meta-data android:name="android.app.func_name" android:value="sparkles_wsi_onCreate" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
