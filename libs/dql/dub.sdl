name "dql"
description "D Query Language: path-based addressing, typed constraint evaluation, fuzzy matching, and zero-allocation predicate filtering"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetPath "build"
sourcePaths "src"
importPaths "src"

dflags "-preview=in" "-preview=dip1000"

dependency "expected" version="~>0.4.1"
dependency "sparkles:base" path="../.."
dependency "sparkles:fuzzy" path="../.."
dependency "sparkles:metadata" path="../.."

configuration "library" {
    targetType "library"
}

configuration "unittest" {
    dependency "sparkles:test-runner" path="../.."
    // Integration schemas over the real event vocabularies: the queried
    // types are ordinary library values; the DQL side reads them through the
    // reflection kernel. Test-only edges — neither input nor wsi knows DQL.
    dependency "sparkles:input" path="../.."
    dependency "sparkles:wsi" path="../.."
    // The integration schemas live outside `src/` so a consumer that
    // source-includes `../dql/src` for its own unittests (the property tree
    // does) never sees modules that would drag `sparkles:wsi` into its
    // import closure.
    sourcePaths "test"

    dflags "-checkaction=context" "-allinst"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}

buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
