name "dql"
description "D Query Language: path-based addressing, typed constraint evaluation, fuzzy matching, and zero-allocation predicate filtering"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetPath "build"
sourcePaths "src"
importPaths "src"

dflags "-preview=in" "-preview=dip1000"

dependency "sparkles:base" path="../.."
dependency "sparkles:fuzzy" path="../.."
dependency "sparkles:metadata" path="../.."

configuration "library" {
    targetType "library"
}

configuration "unittest" {
    // Cycle-safe path: `sparkles:wired` depends on this package (its SDL
    // selector filters with DQL), and wired is in the impl library's
    // dependency closure (impl -> ui -> wired), so a `dependency` on the
    // runner shim would close `dql -> test-runner -> impl -> ui -> wired ->
    // dql`. Source-include the shim and the impl instead, as wired and fuzzy
    // do for the same reason.
    sourcePaths "../test-runner/src" "../test-runner-impl/src"
    importPaths "src" "../test-runner/src" "../test-runner-impl/src"
    // An integration schema over a real event vocabulary: the queried
    // types are ordinary library values; the DQL side reads them through the
    // reflection kernel. A test-only edge — input does not know DQL, and its
    // own tests source-include the runner, so the edge closes no cycle. The
    // WindowEvent schema test lives in wsi instead: wsi depends on the
    // runner, so an edge to it from here would.
    dependency "sparkles:input" path="../.."
    // The integration schemas live outside `src/`, so no consumer of this
    // library sees modules that would drag `sparkles:input` into its import
    // closure.
    sourcePaths "test"

    dflags "-checkaction=context" "-allinst"
}

// Optimised unittest build for `dub test :dql -b bench -- --bench` — dub's
// stock unittest build type reports debug-build numbers.

// BEGIN managed build types — apps/ci/tools/standardize-build-settings.d
dflags "--linker=lld" platform="linux-ldc"
dflags "-L-fuse-ld=lld" platform="linux-dmd"

buildType "unittest" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-debug" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov" {
    buildOptions "unittests" "coverage" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov-ctfe" {
    buildOptions "unittests" "coverageCTFE" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
buildType "bench" {
    buildOptions "unittests" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-unchecked" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-static" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "--link-defaultlib-shared=false" platform="linux-ldc"
    dflags "-defaultlib=libphobos2.a" platform="linux-dmd"
    lflags "--export-dynamic" platform="linux-ldc"
}
// END managed build types
