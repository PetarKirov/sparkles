/// Public import surface for the `libghostty-vt` bindings.
///
/// The raw ImportC declarations live in `sparkles.ghostty.c` (generated by
/// compiling `c.c`, which `#include`s `<ghostty/vt.h>`); the D conveniences
/// over them in `sparkles.ghostty.helpers`. Import this package to pull in
/// both as `import sparkles.ghostty;`.
module sparkles.ghostty;

public import sparkles.ghostty.c;
public import sparkles.ghostty.helpers;
