#!/usr/bin/env dub
/+ dub.sdl:
    name "gen_float_conv_tables"
    targetPath "build"
    dependency "sparkles:base" path="../../.."
    dflags "-preview=in" "-preview=dip1000"
    buildType "checked" {
        buildOptions "optimize" "inline" "debugInfo"
    }
+/
/** Writes `sparkles.base.text.float_conv_tables`: the power-of-ten tables
 * that `sparkles.base.text.float_conv` computes by exact big-integer
 * arithmetic. Evaluated at CTFE they cost every compile that imports the
 * module 1.6 s (DMD) to 3 s (LDC), so they are computed here, once, and
 * checked in; `float_conv`'s `float_conv.tables.matchGenerators` test
 * recomputes them and compares.
 *
 * Run from the repository root after changing a generator or the table
 * bounds: `dub run --single libs/base/tools/gen_float_conv_tables.d`.
 */
module sparkles.base.tools.gen_float_conv_tables;

import std.array : appender;
import std.file : write;
import std.format : formattedWrite;

import sparkles.base.text.float_conv : generateAnchorsNeg, generateAnchorsPos,
    generatePow10Table;

private enum output = "libs/base/src/sparkles/base/text/float_conv_tables.d";

private enum header = q"EOS
// Generated by libs/base/tools/gen_float_conv_tables.d; DO NOT EDIT.
/**
The power-of-ten tables of $(MREF sparkles,base,text,float_conv), computed
by its generators and checked in, so that no compile evaluates them.
*/
module sparkles.base.text.float_conv_tables;

package(sparkles.base):

/// The top 128 bits of a power of ten, normalized to `[2^127, 2^128)`.
struct Pow10Entry
{
    ulong hi;
    ulong lo;
}

/**
A power of ten as the wide tier sees it: `10^q ∈ [E, E + width) × 2^exp2`
with `E = hi:lo` in `[2^127, 2^128)`. A fine entry ($(LREF pow10Sig128)) and
an anchor are truncated once and have width 1; a composed entry — the top 128
bits of an anchor times a fine entry — has width 5: each factor's truncation
scaled by the other factor, which is below `2^128`, plus the product's own
truncation, all over a normalizing shift of at least 127.
*/
struct Pow10Wide
{
    ulong hi;
    ulong lo;
    int exp2;
    int width;
}

/**
For each `q` in `[tableMinExp10, tableMaxExp10]`: the top 128 bits of the
binary expansion of `10^q`, normalized to `[2^127, 2^128)` and truncated
(never rounded up) — the yyjson convention, which both the Eisel–Lemire
reader and the Schubfach writer build on (the writer applies its own +1
ceiling adjustment). The power-of-two factor lives in the exponent
formulas.
*/
EOS";

void main()
{
    auto text = appender!string;
    text.put(header);

    const fine = generatePow10Table();
    text.formattedWrite!"static immutable Pow10Entry[%s] pow10Sig128 = [\n"(fine.length);
    foreach (e; fine)
        text.formattedWrite!"    Pow10Entry(0x%016X, 0x%016X),\n"(e.hi, e.lo);
    text.put("];\n");

    void anchors(R)(string name, string doc, in R table)
    {
        text.formattedWrite!"\n/// %s\nstatic immutable Pow10Wide[%s] %s = [\n"(doc,
            table.length, name);
        foreach (a; table)
            text.formattedWrite!"    Pow10Wide(0x%016X, 0x%016X, %s, %s),\n"(a.hi, a.lo,
                a.exp2, a.width);
        text.put("];\n");
    }
    anchors("pow10AnchorsPos", "The anchors `10^(324·j)`, `j = 1 ..`, with their exact exponents.",
        generateAnchorsPos());
    anchors("pow10AnchorsNeg", "The anchors `10^(−343·j)`, `j = 1 ..`, with their exact exponents.",
        generateAnchorsNeg());

    write(output, text[]);
}
