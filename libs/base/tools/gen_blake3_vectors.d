#!/usr/bin/env dub
/+ dub.sdl:
    name "gen_blake3_vectors"
    buildType "checked" {
        buildOptions "optimize" "inline" "debugInfo"
    }
+/
/** Regenerates `sparkles.base.hash.blake3_vectors` from the official BLAKE3
 * `test_vectors/test_vectors.json`.
 *
 * Usage: dub run --single libs/base/tools/gen_blake3_vectors.d --
 *   $REPOS/BLAKE3/test_vectors/test_vectors.json <upstream-rev>
 *   > libs/base/src/sparkles/base/hash/blake3_vectors.d
 */
module sparkles.base.tools.gen_blake3_vectors;

import std.json : parseJSON;
import std.file : readText;
import std.stdio : writefln, writeln;

void main(string[] args)
{
    if (args.length != 3)
    {
        writeln("usage: gen_blake3_vectors <test_vectors.json> <upstream-rev>");
        return;
    }
    const json = parseJSON(readText(args[1]));
    writeln("// Generated by libs/base/tools/gen_blake3_vectors.d from");
    writefln("// BLAKE3 test_vectors/test_vectors.json at upstream revision %s:", args[2]);
    writeln("//   dub run --single libs/base/tools/gen_blake3_vectors.d -- \\");
    writeln("//     $REPOS/BLAKE3/test_vectors/test_vectors.json ", args[2], " \\");
    writeln("//     > libs/base/src/sparkles/base/hash/blake3_vectors.d");
    writeln("// Do not edit by hand.");
    writeln("/**");
    writeln("The official BLAKE3 test vectors. Each input is the repeating byte");
    writeln("sequence 0, 1, …, 250 of `inputLength` bytes; every expected output is");
    writeln("a 131-byte extended output (hex) whose first 32 bytes are the default.");
    writeln("*/");
    writeln("module sparkles.base.hash.blake3_vectors;");
    writeln();
    writeln("version (unittest):");
    writeln();
    writeln("package(sparkles.base.hash):");
    writeln();
    writeln("/// The keyed-hash key (32 ASCII bytes).");
    writefln("enum string blake3VectorKey = %(%s%);", [json["key"].str]);
    writeln("/// The derive-key context string.");
    writefln("enum string blake3VectorContext = %(%s%);", [json["context_string"].str]);
    writeln();
    writeln("/// One official case: an input length and the three modes' outputs.");
    writeln("struct Blake3Vector");
    writeln("{");
    writeln("    size_t inputLength;");
    writeln("    string hash;");
    writeln("    string keyedHash;");
    writeln("    string deriveKey;");
    writeln("}");
    writeln();
    writeln("/// Every case, in upstream order.");
    writeln("static immutable Blake3Vector[] blake3Vectors = [");
    foreach (c; json["cases"].array)
    {
        writefln("    Blake3Vector(%s,", c["input_len"].integer);
        writefln("        \"%s\",", c["hash"].str);
        writefln("        \"%s\",", c["keyed_hash"].str);
        writefln("        \"%s\"),", c["derive_key"].str);
    }
    writeln("];");
}
