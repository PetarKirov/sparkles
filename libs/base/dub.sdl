name "base"
description "Allocation-conscious base utilities for Sparkles libraries"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetPath "build"

// `attributes` (imported unconditionally by modules with `@betterC` tests)
// lives in the shim; the impl's tree is unittest-only.
importPaths "src" "../test-runner/src"

dflags "-preview=in" "-preview=dip1000"
// Keep downstream template emission consistent across library consumers.
dflags "-linkonce-templates" platform="ldc"

dependency "expected" version="~>0.4.1"
// Structural classification for the shared value-writing dispatch: the text
// writers, the property tree, and query engines answer "what shape is this
// value" from one ladder.
dependency "sparkles:reflection" path="../.."
// The format vocabulary (`CaseStyle`, `@WireName`, the format tags) that the
// text writers and readers resolve names through (`sparkles.base.text.wire_names`).
dependency "sparkles:metadata" path="../.."

targetType "library"

configuration "library" {
    targetType "library"
}

configuration "unittest" {
    // `base`/`core-cli` cannot depend on the impl library (cycle: impl → base),
    // so they source-include both the shim and the impl.
    sourcePaths "../test-runner/src" "../test-runner-impl/src"
    importPaths "src" "../test-runner/src" "../test-runner-impl/src"
    buildRequirements "disallowDeprecations"

    dflags "-checkaction=context" "-allinst"
}

// The unittest build with base.sync's portable thread parker in place of the
// native seam (SPEC SYF2, DS24), so a leg with a native mechanism also runs
// the fallback: `dub test :base -c unittest-portable -- -i "sync\."`.
configuration "unittest-portable" {
    sourcePaths "../test-runner/src" "../test-runner-impl/src"
    importPaths "src" "../test-runner/src" "../test-runner-impl/src"
    buildRequirements "disallowDeprecations"
    versions "SparklesSyncPortableParker"

    dflags "-checkaction=context" "-allinst"
}

// Linux allocation audit for the capability VFS (testing.md § allocation): the
// audit module wraps the libc allocation family and compares druntime's
// per-thread GC counter around the VFS operations. Separate, so GNU ld's --wrap
// is never imposed on library consumers.
configuration "allocation-audit" {
    targetType "library"
    sourcePaths "../test-runner/src" "../test-runner-impl/src"
    importPaths "src" "../test-runner/src" "../test-runner-impl/src"
    versions "VfsAllocationAudit"
    dflags "-checkaction=context" "-allinst"
    lflags "--wrap=malloc" "--wrap=calloc" "--wrap=realloc" platform="linux"
}

// Real numbers need release codegen: dub's stock `unittest` build type is a
// debug build (the runner prints an assert-build warning under --bench), so
// unchecked benchmarks run via `dub test :base -b bench-unchecked -- --bench …`.
// `unittests` is
// the load-bearing option — without it `dub test` registers zero tests.
// No `-enable-cross-module-inlining`: build types propagate to dependencies
// (see the cross-module-inlining note in docs/libs/test-runner/how-to/benchmark.md).

// BEGIN managed build types — apps/ci/tools/standardize-build-settings.d
buildType "unittest" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-debug" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov" {
    buildOptions "unittests" "coverage" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov-ctfe" {
    buildOptions "unittests" "coverageCTFE" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
buildType "bench" {
    buildOptions "unittests" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-unchecked" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-static" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "--link-defaultlib-shared=false" "--linker=gold" platform="linux-ldc"
    dflags "-defaultlib=libphobos2.a" "-L-fuse-ld=gold" platform="linux-dmd"
    lflags "--export-dynamic" platform="linux-ldc"
}
// END managed build types
