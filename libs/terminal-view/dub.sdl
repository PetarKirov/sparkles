name "terminal-view"
description "The terminal core as an embeddable component: libghostty screen, per-cell renderer, input encoding, pty lifecycle"
authors "Petar Kirov"
license "BSL-1.0"

targetPath "build"

dflags "-preview=in" "-preview=dip1000"

dependency "expected" version="~>0.4.0"

dependency "sparkles:android" path="../.."
dependency "sparkles:base" path="../.."
dependency "sparkles:event-horizon" path="../.."
dependency "sparkles:ghostty" path="../.."
dependency "sparkles:input" path="../.."
dependency "sparkles:ui" path="../.."

// The terminal painted and its mouse polled with raylib: what the desktop
// terminal and the gallery build today.
configuration "library" {
    targetType "sourceLibrary"
    dependency "raylib-d" version="~>6.0.1"
    dependency "sparkles:raylib-text" path="../.."
    libs "raylib"
    versions "TerminalViewRaylib"
}

// No raylib: the renderer through a painter the host supplies
// (`isTerminalPainter`), the mouse from the host's events.
configuration "core" {
    targetType "sourceLibrary"
    excludedSourceFiles "src/sparkles/terminal_view/raylib_*.d"
}

// The core configuration's sources, so the tests prove it builds without
// raylib (plan slice V5 of `docs/specs/ui-vulkan`).
configuration "unittest" {
    excludedSourceFiles "src/sparkles/terminal_view/raylib_*.d"
    // Compile the Vulkan component branches in tests (sources already exclude raylib).
    versions "TerminalViewVulkan"
    dependency "sparkles:test-runner" path="../.."
    // The recording host the mouse scenarios run through (`pointer_test.d`).
    dependency "sparkles:ui-app" path="../.."
    subConfiguration "sparkles:ui-app" "tui"

    dflags "-checkaction=context" "-allinst"
}

// The core sources plus the Vulkan painter. A native host selects this so
// `paintPanePx` draws through `VulkanTerminalPainter` (`UVX11`).
configuration "vulkan" {
    targetType "sourceLibrary"
    excludedSourceFiles "src/sparkles/terminal_view/raylib_*.d"
    versions "TerminalViewVulkan"
}

// BEGIN managed build types — apps/ci/tools/standardize-build-settings.d
dflags "--linker=lld" platform="linux-ldc"
dflags "-L-fuse-ld=lld" platform="linux-dmd"

buildType "unittest" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-debug" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov" {
    buildOptions "unittests" "coverage" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov-ctfe" {
    buildOptions "unittests" "coverageCTFE" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
buildType "bench" {
    buildOptions "unittests" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-unchecked" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-static" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "--link-defaultlib-shared=false" platform="linux-ldc"
    dflags "-defaultlib=libphobos2.a" platform="linux-dmd"
    lflags "--export-dynamic" platform="linux-ldc"
}
// END managed build types
