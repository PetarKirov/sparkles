name "raylib-text"
description "Reusable raylib text rendering: font sets, glyph fallback, styled text drawing"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetPath "build"

importPaths "src"

dflags "-preview=in" "-preview=dip1000"

// raylib comes in two halves: the D bindings via dub, and the native library via
// the linker. raylib-d's `library` config does NOT declare `libs "raylib"`, so
// this package owns it; both propagate transitively to consuming executables
// (each still needs the native raylib present at link/run time).
dependency "raylib-d" version="~>6.0.1"
libs "raylib"

// SmallBuffer (unique mode) backs the per-face sorted glyph maps and the
// on-demand request set — the same @nogc buffers apps/terminal uses.
dependency "sparkles:base" path="../.."

configuration "library" {
    targetType "library"
}

configuration "unittest" {
    // Only raylib-FREE code carries unittests — the GL-backed FontSet/drawText
    // are validated by the apps' screenshot goldens — so `dub test :raylib-text`
    // runs headless (linking libraylib.so needs no display; only
    // InitWindow/LoadFontEx/DrawTextEx do).
    //
    // font_discovery.d is where the portable half lives: name→path resolution,
    // the sibling naming convention and charset parsing, with no raylib import
    // at all (it compiles with raylib absent from the import path entirely).
    // font_coretext.d is its macOS sibling — the system font database, reached
    // by dlopen, so it too is raylib-free and testable.
    //
    // Source-including the shim + impl (the cycle-safe recipe base/core-cli
    // use) rather than taking the runner as a plain `dependency`: font_coretext
    // calls `skipTest` when the frameworks are unavailable, and skipTest lives
    // in the impl package. As a `dependency` the impl links as a static archive
    // positioned BEFORE these objects, so ld.bfd (single-pass) never pulls
    // skip.o and the build fails on an undefined reference. There is no cycle
    // to fear here: nothing in the impl's closure depends on raylib-text.
    sourcePaths "../test-runner/src" "../test-runner-impl/src"
    importPaths "src" "../test-runner/src" "../test-runner-impl/src"

    dflags "-checkaction=context" "-allinst"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
// Optimised, assertions live, `debug {}` blocks out — the build every nix
// artifact uses. Neither `debug` (which compiles those blocks in) nor
// `release` (which deletes assert *expressions*, side effects included).
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
