name "dub-manifest-nix-wasm"
description "PROTOTYPE (#452): parseDubManifest as a Nix builtins.wasm module"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetPath "build"
targetType "executable"
targetName "spk-dub-manifest"

dependency "sparkles:wired" path="../../.."

// Prototype only: the recipe schema is compiled straight from
// build-primitives, whose other modules (event-horizon) do not build for wasm.
importPaths "src" "../src"
sourcePaths "src"
sourceFiles "../src/sparkles/build_primitives/dub_manifest.d"

dflags "-preview=in" "-preview=dip1000"
// The `env` host functions are imports the Nix evaluator provides.
lflags "--allow-undefined" platform="wasi"

buildType "wasm-lto" {
    buildOptions "optimize" "inline"
    dflags "-flto=full" "-defaultlib=phobos2-ldc-lto,druntime-ldc-lto" platform="wasi"
    lflags "--gc-sections" platform="wasi"
}
