/**
The `nix` target (fileset explorer `FXE3`): a query as a `lib.fileset`
expression.

The algebra maps to `lib.fileset`'s own functions, `fileFilter` to Nix's
`fileFilter` and `gitTracked` to `lib.fileset.gitTracked`. Nix has no globs, so
a glob goes by the chosen `NixGlobs` mode: through `glob`, a function the
output defines, which walks the root with `builtins.readDir` when Nix
evaluates it and matches the glob's regular expression (the default); as the
paths it matches in the open directory now, marked as a snapshot; or, refused
unless it is a literal anchored path.
*/
module sparkles.build_primitives.fileset.emit.nix;

import std.array : join;

import sparkles.build_primitives.fileset.emit.ir : expandBraces, GlobParts, isLiteral, parseGlob;
import sparkles.build_primitives.fileset.emit.result : EmitOptions, Emitted, NixGlobs, refuse;
import sparkles.build_primitives.fileset.query : canonical, NodeKind, noNode, PredKind, Query, Span;

/// The Nix expression of `q`: `{ lib }: … fs.toSource { … }`.
Emitted emitNix(const Query q, in EmitOptions o) @safe
{
    auto p = NixParts.of(q, o);
    if (!p.ok)
        return p.refusal;
    return Emitted(true, p.render("fs.toSource {\n  inherit root;\n  fileset = %s;\n}"));
}

/**
The pieces of the Nix expression: its `let` bindings and the fileset
expression. The oracle composes them with `lib.fileset.toList`.
*/
struct NixParts
{
    bool ok;            ///
    Emitted refusal;    /// when not `ok`
    string fileset;     /// the fileset expression
    bool usesGlob;      /// it calls the `glob` shim
    string header;      /// the generated-by comment
    string[] snapshots; /// the globs written as the paths they matched

    /// The whole file, with `body` (a `%s` for the fileset) as its result.
    string render(string body) const @safe
    {
        import std.array : replace;
        import std.format : format;

        string s = header;
        foreach (g; snapshots)
            s ~= "# A snapshot: `" ~ g ~ "` is written as the paths it matched when generated.\n";
        s ~= "{ lib }:\nlet\n  fs = lib.fileset;\n  root = ./.;\n";
        if (usesGlob)
            s ~= globShim;
        // A fileset written over several lines continues at its binding's depth.
        return s ~ "in\n" ~ format(body, fileset.replace("\n", "\n  ")) ~ "\n";
    }

    /// Translates `q` under `o`.
    static NixParts of(const Query q, in EmitOptions o) @safe
    {
        NixParts p;
        p.header = "# Generated by fileset-explorer from:\n#   " ~ canonical(q) ~ "\n";
        if (q.root == noNode)
        {
            p.ok = true;
            p.fileset = "fs.unions [ ]";
            return p;
        }
        string err;
        Span at;

        string predText(uint i)
        {
            const pr = q.preds[i];
            final switch (pr.kind)
            {
                case PredKind.hasExt: return "file.hasExt " ~ nixString(pr.value);
                case PredKind.name: return "file.name == " ~ nixString(pr.value);
                case PredKind.type: return "file.type == " ~ nixString(pr.value);
                case PredKind.not: return "!(" ~ predText(pr.a) ~ ")";
                case PredKind.and: return "(" ~ predText(pr.a) ~ " && " ~ predText(pr.b) ~ ")";
                case PredKind.or: return "(" ~ predText(pr.a) ~ " || " ~ predText(pr.b) ~ ")";
            }
        }

        string globExpr(string text, Span span)
        {
            final switch (o.nixGlobs)
            {
                case NixGlobs.shim:
                    p.usesGlob = true;
                    const g = parseGlob(text);
                    return "(glob " ~ (g.dirOnly ? "true" : "false") ~ " " ~ nixString(globRegex(text)) ~ ")";
                case NixGlobs.expand:
                    if (o.expand is null)
                    {
                        err = "nothing to expand the glob against";
                        at = span;
                        return null;
                    }
                    string[] paths;
                    foreach (path; o.expand(text))
                        paths ~= nixPath(path);
                    p.snapshots ~= text;
                    return nixCall("fs.unions", paths, true);
                case NixGlobs.refuse:
                    const g = parseGlob(text);
                    if (g.anchored && !g.dirOnly && isLiteral(g.body))
                        return "(fs.maybeMissing " ~ nixPath(g.body) ~ ")";
                    err = "lib.fileset has no globs; choose the glob shim or a snapshot";
                    at = span;
                    return null;
            }
        }

        string walk(uint n)
        {
            if (err)
                return null;
            const node = q.nodes[n];
            final switch (node.kind)
            {
                case NodeKind.all: return "root";
                case NodeKind.none: return "(fs.unions [ ])";
                case NodeKind.gitTracked: return "(fs.gitTracked root)";
                case NodeKind.exec:
                    err = "Nix evaluation cannot see a file's executable bit";
                    at = node.span;
                    return null;
                case NodeKind.gitignored:
                    if (!o.gitignoredIsUntracked)
                    {
                        err = "lib.fileset has no `gitignored`; it is the root minus `gitTracked` only in a "
                            ~ "work tree with no untracked files and no ignored tracked ones";
                        at = node.span;
                        return null;
                    }
                    return "(fs.difference root (fs.gitTracked root))";
                case NodeKind.fileFilter:
                    return "(fs.fileFilter (file: " ~ predText(node.pred) ~ ") root)";
                case NodeKind.union_:
                    string[] parts;
                    foreach (a; node.args)
                        parts ~= walk(a);
                    return nixCall("fs.unions", parts, true);
                case NodeKind.intersection, NodeKind.difference:
                    const f = node.kind == NodeKind.intersection ? "fs.intersection" : "fs.difference";
                    return nixCall(f, [walk(node.args[0]), walk(node.args[1])], false);
                case NodeKind.glob:
                    return globExpr(node.text, node.span);
            }
        }

        p.fileset = walk(q.root);
        if (err)
        {
            p.refusal = refuse(err, at);
            return p;
        }
        p.ok = true;
        return p;
    }
}

/// The `glob` function the output defines (`FXE3`'s shim): the files beneath
/// `root` whose path, or a directory's above them, matches `re`.
enum string globShim =
    "  # The fileset explorer's globs: the files beneath `root` whose path, or the\n" ~
    "  # path of a directory above them, matches `re` (a whole match); with\n" ~
    "  # `dirOnly`, only a directory's. Walked with builtins.readDir as Nix\n" ~
    "  # evaluates it, so it holds for files added later.\n" ~
    "  glob = dirOnly: re:\n" ~
    "    let\n" ~
    "      walk = dir: rel:\n" ~
    "        lib.concatLists (lib.mapAttrsToList (name: type:\n" ~
    "          let\n" ~
    "            path = if rel == \"\" then name else \"${rel}/${name}\";\n" ~
    "            matches = builtins.match re path != null;\n" ~
    "          in\n" ~
    "          if matches && (type == \"directory\" || !dirOnly) then [ (dir + \"/${name}\") ]\n" ~
    "          else if type == \"directory\" then walk (dir + \"/${name}\") path\n" ~
    "          else [ ]\n" ~
    "        ) (builtins.readDir dir));\n" ~
    "    in\n" ~
    "    fs.unions (walk root \"\");\n";

/// `s` as a Nix string literal.
string nixString(scope const(char)[] s) @safe pure
{
    string r = "\"";
    foreach (i, c; s)
    {
        if (c == '"' || c == '\\' || (c == '$' && i + 1 < s.length && s[i + 1] == '{'))
            r ~= '\\';
        r ~= c;
    }
    return r ~ "\"";
}

/// The widest a call is written on one line; a wider one, or one whose
/// arguments span lines, is written an argument a line.
enum size_t nixLineWidth = 72;

/**
`(f a b)`, or with `list`, `(f [ a b ])`: on one line while it fits in
$(LREF nixLineWidth), else an argument a line, each indented two spaces past
the call, so a snapshot of hundreds of paths reads, and diffs, a path a line.
*/
string nixCall(string f, in string[] args, bool list) @safe pure
{
    import std.algorithm.searching : canFind;

    const one = list ? "(" ~ f ~ " [ " ~ args.join(" ") ~ " ])" : "(" ~ f ~ " " ~ args.join(" ") ~ ")";
    if (one.length <= nixLineWidth && !one.canFind('\n'))
        return one;
    string s = "(" ~ f ~ (list ? " [\n" : "\n");
    foreach (a; args)
        s ~= indentNix(a) ~ "\n";
    return s ~ (list ? "])" : ")");
}

///
@("emit.nix.nixCall")
@safe pure unittest
{
    assert(nixCall("fs.unions", ["a", "b"], true) == "(fs.unions [ a b ])");
    assert(nixCall("fs.difference", ["a", "b"], false) == "(fs.difference a b)");
    string[] many;
    foreach (i; 0 .. 8)
        many ~= nixPath("src/file.d");
    assert(nixCall("fs.unions", many, true) == "(fs.unions [\n" ~ "  (root + \"/src/file.d\")\n".replicate(8) ~ "])");
    assert(nixCall("fs.difference", [nixCall("fs.unions", many, true), "root"], false)
        == "(fs.difference\n  (fs.unions [\n" ~ "    (root + \"/src/file.d\")\n".replicate(8) ~ "  ])\n  root\n)",
        "nested calls indent further");
}

private string replicate(string s, size_t n) @safe pure
{
    string r;
    foreach (_; 0 .. n)
        r ~= s;
    return r;
}

// `s` with every line indented two spaces.
private string indentNix(string s) @safe pure
{
    import std.array : replace;

    return "  " ~ s.replace("\n", "\n  ");
}

/// A path beneath `root`: `root + "/a/b"`, which holds any characters.
string nixPath(scope const(char)[] rel) @safe pure => "(root + " ~ nixString("/" ~ rel) ~ ")";

/**
The POSIX extended regular expression `builtins.match` matches a path against
for `glob`: a whole path relative to the root, anchored or, for an unanchored
glob, at any depth. A segment `**` is any number of directories.
*/
string globRegex(string glob) @safe pure
{
    import std.algorithm.iteration : splitter;

    string[] alts;
    foreach (one; expandBraces(glob))
    {
        const g = parseGlob(one);
        string re = g.anchored ? "" : "(.*/)?";
        string[] segs;
        foreach (seg; g.body.splitter('/'))
            segs ~= seg;
        // `noSlash`: the next segment follows without a `/` — at the start,
        // and after a leading `**`, whose group already ends in one.
        bool noSlash = true;
        foreach (i, seg; segs)
        {
            if (seg == "**")
            {
                if (i + 1 == segs.length)
                    re ~= noSlash ? ".*" : "/.*"; // everything beneath
                else if (noSlash)
                    re ~= "(.*/)?";               // any directories, or none
                else
                    re ~= "(/.*)?";               // `a/**/b` holds `a/b`
                continue;
            }
            if (!noSlash)
                re ~= "/";
            re ~= segmentRegex(seg);
            noSlash = false;
        }
        alts ~= re;
    }
    return alts.length == 1 ? alts[0] : "(" ~ alts.join("|") ~ ")";
}

// One path segment's glob as a regular expression over a component.
private string segmentRegex(string seg) @safe pure
{
    string re;
    for (size_t i; i < seg.length; ++i)
    {
        const c = seg[i];
        switch (c)
        {
            case '*': re ~= "[^/]*"; break;
            case '?': re ~= "[^/]"; break;
            case '\\':
                if (i + 1 < seg.length)
                    re ~= quoteRegex(seg[++i]);
                break;
            case '[':
                size_t j = i + 1;
                string cls = "[";
                if (j < seg.length && (seg[j] == '!' || seg[j] == '^'))
                {
                    cls ~= "^";
                    ++j;
                }
                if (j < seg.length && seg[j] == ']')
                    cls ~= seg[j++];
                while (j < seg.length && seg[j] != ']')
                    cls ~= seg[j++];
                re ~= cls ~ "]";
                i = j;
                break;
            default: re ~= quoteRegex(c); break;
        }
    }
    return re;
}

private string quoteRegex(char c) @safe pure
{
    switch (c)
    {
        case '.', '+', '(', ')', '|', '^', '$', '{', '}', '[', ']', '*', '?', '\\':
            return "\\" ~ c;
        default:
            return [c];
    }
}

///
@("fileset.emit.nix.globRegex")
@safe pure unittest
{
    assert(globRegex("*.d") == "(.*/)?[^/]*\\.d");
    assert(globRegex("/README.md") == "README\\.md");
    assert(globRegex("src/**") == "src/.*");
    assert(globRegex("src/**/*.d") == "src(/.*)?/[^/]*\\.d");
    assert(globRegex("**/x") == "(.*/)?x");
    assert(globRegex("*.{d,di}") == "((.*/)?[^/]*\\.d|(.*/)?[^/]*\\.di)");
    assert(globRegex("[!a]?") == "(.*/)?[^a][^/]");
}
