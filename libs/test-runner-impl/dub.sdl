name "test-runner-impl"
description "The sparkles:test-runner runner executable, sparkles-test-runner (internal — tests depend on sparkles:test-runner)"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetPath "build"
targetName "sparkles-test-runner"

dflags "-preview=in" "-preview=dip1000"

// The runner proper: the command line, scheduling across worker processes,
// reports, --bench-json, and the compile-time and extracted modes. It drives
// test binaries over the runner protocol and is never linked into one, so
// test binaries run it from a pinned revision (nix/test-runner-pin.json) and
// a change here reaches only this package's own tests until the pin moves
// (docs/specs/test-runner/process-model.md).
dependency "sparkles:test-harness" path="../.."
dependency "sparkles:base" path="../.."

// The reporting UI (result tables, progress lines, OSC-8 links, the live
// region) comes from the toolkit, not from the CLI package.
dependency "sparkles:ui" path="../.."

// The counters a benchmark reads (perf groups, rdpmc, syscalls, pressure
// stalls) are `sparkles.profiling.counters`, shared with frame profiling. They
// arrive with `sparkles:test-harness`, which compiles them from source; a
// dependency on `sparkles:profiling` as well would link them twice.

configuration "application" {
    targetType "executable"
    mainSourceFile "src/sparkles/test_runner/app.d"
}

configuration "unittest" {
    targetType "library"
    excludedSourceFiles "src/sparkles/test_runner/app.d"
    dependency "sparkles:test-runner" path="../.."

    dflags "-checkaction=context" "-allinst"
}

// BEGIN managed build types — apps/ci/tools/standardize-build-settings.d
dflags "--linker=lld" platform="linux-ldc"
dflags "-L-fuse-ld=lld" platform="linux-dmd"

buildType "unittest" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-debug" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov" {
    buildOptions "unittests" "coverage" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov-ctfe" {
    buildOptions "unittests" "coverageCTFE" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
buildType "bench" {
    buildOptions "unittests" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-unchecked" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-static" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "--link-defaultlib-shared=false" platform="linux-ldc"
    dflags "-defaultlib=libphobos2.a" platform="linux-dmd"
    lflags "--export-dynamic" platform="linux-ldc"
}
// END managed build types
