// Tests
// ---------------------------------------------------------------------------

@("test_utils.goldens.blessOnlyOnExactlyOne")
@safe
unittest
{
    const had = environment.get(goldenBlessEnvVar, null);
    scope (exit)
    {
        if (had is null)
            environment.remove(goldenBlessEnvVar);
        else
            environment[goldenBlessEnvVar] = had;
    }

    environment.remove(goldenBlessEnvVar);
    assert(!blessingGoldens);

    environment[goldenBlessEnvVar] = "1";
    assert(blessingGoldens);

    // The spelling anyone reaches for to turn a variable off. Two of the three
    // suites this replaces blessed on it.
    environment[goldenBlessEnvVar] = "0";
    assert(!blessingGoldens);
    environment[goldenBlessEnvVar] = "";
    assert(!blessingGoldens);
    environment[goldenBlessEnvVar] = "yes";
    assert(!blessingGoldens);
}

@("test_utils.goldens.aMissingGoldenIsAFailureNotABlessing")
@system
unittest
{
    import core.exception : AssertError;
    import sparkles.test_utils.tmpfs : TmpFS;
    import std.algorithm : canFind;
    import std.file : exists;
    import std.path : buildPath;

    auto tmp = TmpFS.create();
    tmp.ensureDir();
    const path = tmp.dir.buildPath("absent.txt");

    bool threw;
    try
        checkGolden("something", path, "dub test :thing -- -i golden");
    catch (AssertError e)
    {
        threw = true;
        // The command has to be in the message: whoever reads this did not
        // write the suite and cannot guess how it is regenerated.
        assert(e.msg.canFind("dub test :thing -- -i golden"), e.msg);
    }
    assert(threw, "a golden that does not exist must not silently be created");
    assert(!path.exists);
}

@("test_utils.goldens.matchPassesMismatchNamesTheLine")
@system
unittest
{
    import core.exception : AssertError;
    import sparkles.test_utils.tmpfs : TmpFS;
    import std.algorithm : canFind;
    import std.path : buildPath;

    auto tmp = TmpFS.create();
    const path = tmp.writeFile("alpha\nbeta\ngamma\n");

    checkGolden("alpha\nbeta\ngamma\n", path, "regen");

    bool threw;
    try
        checkGolden("alpha\nBETA\ngamma\n", path, "regen");
    catch (AssertError e)
    {
        threw = true;
        assert(e.msg.canFind("line 2"), e.msg);
        assert(e.msg.canFind("regen"), e.msg);
    }
    assert(threw);
}

@("test_utils.goldens.divergenceDistinguishesGrowthFromLoss")
@safe
unittest
{
    import std.algorithm : canFind;

    // A shared prefix and a different length is the common case for a grid
    // golden: a row appeared, or one went missing. Which way round is the
    // whole finding.
    assert(describeDivergence("a\nb\n", "a\nb\nc\n").canFind("1 lines longer"));
    assert(describeDivergence("a\nb\nc\n", "a\nb\n").canFind("1 lines shorter"));
    assert(describeDivergence("a\nb\n", "a\nb\n") == "");

    // A pure append leaves no differing line to point at, so the message says
    // how far the two agreed instead of reporting nothing.
    const appended = describeDivergence("a\nb", "a\nb\nc");
    assert(appended.canFind("identical through line 2"), appended);
    assert(appended.canFind("1 lines longer"), appended);

    // A long line is elided rather than pasted whole into the message.
    const wide = describeDivergence(
        "x", "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy");
    assert(wide.canFind("…"), wide);
}

@("test_utils.goldens.blessingRewritesAndCreatesTheDirectory")
@system
unittest
{
    import sparkles.test_utils.tmpfs : TmpFS;
    import std.file : readText;
    import std.path : buildPath;

    auto tmp = TmpFS.create();
    tmp.ensureDir();
    const path = tmp.dir.buildPath("nested", "deeper", "g.txt");

    blessGolden("first\n", path);
    assert(readText(path) == "first\n");

    blessGolden("second\n", path);
    assert(readText(path) == "second\n");
}

@("test_utils.goldens.gridTextTrimsTrailingBlanks")
@safe
unittest
{
    // The stand-in is the shape every caller's grid has: `width`, `height`,
    // and `cells[y * width + x].glyph`. Nothing here knows about `sparkles:ui`.
    static struct Cell { dchar glyph; }
    static struct Grid
    {
        size_t width, height;
        Cell[] cells;
    }

    auto g = Grid(4, 2, [
        Cell('a'), Cell('b'), Cell(' '), Cell(' '),
        Cell(' '), Cell('c'), Cell(' '), Cell(' '),
    ]);
    assert(gridText(g) == "ab\n c\n");

    // A wholly blank row is an empty line, not four spaces: a golden full of
    // invisible trailing whitespace is one nobody can review.
    auto blank = Grid(2, 1, [Cell(' '), Cell(' ')]);
    assert(gridText(blank) == "\n");
}
