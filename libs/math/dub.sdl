name "math"
description "Math primitives for games and graphics"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetPath "build"

dflags "-preview=in" "-preview=dip1000"

dependency "sparkles:base" path="../.."

// Cycle-safe runner integration (the recipe `sparkles:shaders` documents):
// `sparkles:shaders` depends on this package and `sparkles:ui` on both, and
// `sparkles:ui` sits in the test-runner-impl's closure, so a
// `dependency "sparkles:test-runner"` here would close
// `math -> test-runner -> impl -> ui -> shaders -> math`. Source-include the
// shim and the impl instead; only the shim is on the top-level import paths.
importPaths "src" "../test-runner/src"

configuration "library" {
    targetType "library"
    excludedSourceFiles "src/app.d"
}

configuration "unittest" {
    excludedSourceFiles "src/app.d"
    sourcePaths "src" "../test-runner/src" "../test-runner-impl/src"
    importPaths "src" "../test-runner/src" "../test-runner-impl/src"

    dflags "-checkaction=context" "-allinst"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
// Optimised, assertions live, `debug {}` blocks out — the build every nix
// artifact uses. Neither `debug` (which compiles those blocks in) nor
// `release` (which deletes assert *expressions*, side effects included).
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
