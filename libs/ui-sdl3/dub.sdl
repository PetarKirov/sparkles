name "ui-sdl3"
description "SDL3 window system for sparkles:ui — window, input source, and the Vulkan surface"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetPath "build"

dflags "-preview=in" "-preview=dip1000"

// pkg-config supplies both the link flags and — prefixed `-P-I` by dub — the
// ImportC include path for the `<SDL3/*.h>` headers.
libs "SDL3"

dependency "sparkles:vulkan" path="../.."
dependency "expected" version="~>0.4.1"

configuration "library" {
    // `sourceLibrary`, not `library`: dub skips pkg-config for `library` and
    // `staticLibrary` targets, so the ImportC include path would never reach
    // the compiler. See docs/guidelines/importc-c-libraries.md.
    targetType "sourceLibrary"
}

configuration "unittest" {
    dependency "sparkles:test-runner" path="../.."
    dependency "sparkles:base" path="../.."

    dflags "-checkaction=context" "-allinst"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
// Optimised, assertions live, `debug {}` blocks out — the build every nix
// artifact uses. Neither `debug` (which compiles those blocks in) nor
// `release` (which deletes assert *expressions*, side effects included).
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
