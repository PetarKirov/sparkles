/**
The wired-inline engine — the same arena parser as `wired-native`, built
from a single-translation-unit copy of its sources
($(D sparkles.wired_bench.engines.wired_inline_impl), generated by
`tools/gen-wired-inline.d`).

Why the copy exists: wired's hot path is templates all the way down
(`parseJsonDocument` → `parseInto` → `scanNumber`), so it is code-generated
in whichever package *instantiates* it — this benchmark package, which
cannot turn on `-enable-cross-module-inlining` (it propagates to mir-ion and
culls a template-nested symbol). `sparkles:wired`'s own `library-inline`
configuration therefore never reaches the instantiation that actually runs,
and the disassembly shows the cost: `tryFastDouble`, `slowDouble` and even
`doubleToBits` — one `movq` — are emitted as calls into `sparkles:base`.

This engine removes that variable entirely: with every seam inside one
module, no inlining flag is needed for LDC to see the whole kernel. The
delta against `wired-native` on the same corpora is the value of inlining,
measured without the build-system variables (cross-module inlining, ThinLTO,
PGO) that could not be evaluated cleanly on this toolchain.

Only `parse` and `validate` are offered: those are the reader kernel. The
copy stops at the reader, so there is no writer or codec here and the
harness's trait detection simply gives this engine no serialize/decode rows.
*/
module sparkles.wired_bench.engines.wired_inline;

import std.exception : enforce;

import sparkles.wired_bench.engines.wired_inline_impl : InlineJsonKind = JsonKind,
    InlineJsonValue = JsonValue, InlineParseResult = JsonParseResult, isValidJson,
    parseJsonDocument;
import sparkles.wired_bench.fingerprint : Fingerprint;

/// Adapter over the single-translation-unit copy of the arena reader.
struct WiredInlineEngine
{
    enum name = "wired-inline";

    /// Shown in the report's notes column — this row is a codegen A/B of the
    /// `wired-native` row, not a separate implementation.
    enum notes = "single-TU copy of wired-native";

    private InlineParseResult!() result;

    /// Full parse; identical work to `wired-native`, including the copy and
    /// padding of the input into the document's string pool (timed — the
    /// immutable-input contract).
    void parse(scope const(char)[] text) @safe
    {
        result = parseJsonDocument(text);
        enforce(result.hasValue, "wired-inline parse failed");
    }

    /// Drops the held document (frees both arena blocks).
    void freeDoc() @safe
    {
        result = InlineParseResult!().init;
    }

    /// ditto
    void teardown() @safe
    {
        freeDoc();
    }

    /// Full-input well-formedness check materializing nothing.
    void validate(scope const(char)[] text) @safe
    {
        enforce(isValidJson(text), "wired-inline validate failed");
    }

    /// Structural fingerprint of the held document. Verified against the
    /// `std.json` reference like every other engine — a mis-spliced copy
    /// error-rows here rather than posting a faster wrong number.
    Fingerprint fingerprint() @safe
    {
        Fingerprint f;
        accumulateInline(result.document.root, f);
        return f;
    }
}

/// Accumulates one view subtree into `f`. A duplicate of `wired_native`'s
/// walk because the copied document is a distinct type from the library's.
private void accumulateInline(scope InlineJsonValue v, ref Fingerprint f) @safe
{
    final switch (v.kind) with (InlineJsonKind)
    {
    case null_:
        f.nulls++;
        break;
    case bool_:
        if (v.boolean)
            f.trues++;
        else
            f.falses++;
        break;
    case integer:
        f.numbers++;
        f.numberSum += v.integer;
        break;
    case uinteger:
        f.numbers++;
        f.numberSum += v.uinteger;
        break;
    case floating:
        f.numbers++;
        f.numberSum += v.floating;
        break;
    case string_:
        f.strings++;
        f.stringBytes += v.str.length;
        break;
    case array:
        f.arrays++;
        f.arrayElems += v.length;
        foreach (e; v.byElement)
            accumulateInline(e, f);
        break;
    case object:
        f.objects++;
        f.objectMembers += v.length;
        foreach (m; v.byKeyValue)
        {
            f.keyBytes += m.key.length;
            accumulateInline(m.value, f);
        }
        break;
    case none, rawNumber:
        assert(false, "unexpected kind in a parsed document");
    }
}

@("WiredInlineEngine.parseMatchesNative")
@system unittest
{
    import sparkles.wired_bench.engines.wired_native : WiredNativeEngine;

    enum sample = `{"a": [1, true, "x", 2.5, null], "b": -1.25e-3,`
        ~ ` "c": "escé\n", "d": 123456789012345678}`;

    WiredInlineEngine inline_;
    WiredNativeEngine native;
    scope (exit)
    {
        inline_.teardown();
        native.teardown();
    }

    inline_.parse(sample);
    native.parse(sample);

    // The copy must agree with its original on every fingerprint field —
    // this is what makes the timing comparison meaningful.
    assert(inline_.fingerprint() == native.fingerprint());
}
