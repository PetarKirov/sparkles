name "wired-wasm"
description "sparkles:wired as a wasm32-wasip1 reactor: the docs' JSON/SDL playground and the npm package"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetPath "build"

dependency "sparkles:base" path="../../.."
dependency "sparkles:wired" path="../../.."
dependency "sparkles:dub-manifest" path="../../.."
// The recipe answers are the Nix module's, through its host-generic
// conversion and in-memory host (docs/specs/wired/wasm WW12).
dependency "sparkles:dub-manifest-nix-wasm" path="../../.."
subConfiguration "sparkles:dub-manifest-nix-wasm" "library"

dflags "-preview=in" "-preview=dip1000"

// The module: `dub build :wired-wasm --arch=wasm32-unknown-wasip1`. A reactor
// (docs/specs/toolchain/wasm-modules.md TCM4) whose exports are TCM5's.
configuration "wasm" {
    targetType "executable"
    targetName "spk-wired"
    dflags "-mexec-model=reactor" platform="wasi"
    lflags "--export=spk_buf_ptr" "--export=spk_buf_cap" "--export=spk_segment" \
        "--export=spk_wired_run" platform="wasi"
}

// The exported function as native D, for the agreement check that compares
// the module with it (`ci check wasm-modules`, TCM9).
configuration "library" {
    targetType "library"
}

configuration "unittest" {
    dependency "sparkles:test-runner" path="../../.."

    dflags "-checkaction=context" "-allinst"
}

// The shipped module (TCM8): link-time optimization across the program,
// druntime and Phobos, then `wasm-opt -Oz` in the Nix build.
buildType "wasm-lto" {
    buildOptions "optimize" "inline"
    dflags "-flto=full" "-defaultlib=phobos2-ldc-lto,druntime-ldc-lto" platform="wasi"
    lflags "--gc-sections" platform="wasi"
}

// BEGIN managed build types — apps/ci/tools/standardize-build-settings.d
dflags "--linker=lld" platform="linux-ldc"
dflags "-L-fuse-ld=lld" platform="linux-dmd"

buildType "unittest" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-debug" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov" {
    buildOptions "unittests" "coverage" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov-ctfe" {
    buildOptions "unittests" "coverageCTFE" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
buildType "bench" {
    buildOptions "unittests" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-unchecked" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-static" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "--link-defaultlib-shared=false" platform="linux-ldc"
    dflags "-defaultlib=libphobos2.a" platform="linux-dmd"
    lflags "--export-dynamic" platform="linux-ldc"
}
// END managed build types
