name "nix"
description "D bindings for the Nix C API (libnix{util,store,expr,fetchers,flake,main}-c)"
authors "Petar Kirov"
license "BSL-1.0"

targetPath "build"

dflags "-preview=in" "-preview=dip1000"

// pkg-config package names (they match the installed .pc files), so dub
// resolves both --cflags (the ImportC include path) and --libs (the real
// -lnix*c link flags, via each .pc's Libs:/Requires: fields).
libs "nix-util-c" "nix-store-c" "nix-expr-c" "nix-fetchers-c" "nix-flake-c" "nix-main-c"

dependency "expected" version="~>0.4.1"

configuration "library" {
    // sourceLibrary so dub's pkg-config --cflags reach the ImportC compile of
    // c.c — see docs/guidelines/importc-c-libraries.md (the sourceLibrary gotcha).
    targetType "sourceLibrary"
    dependency "sparkles:core-cli" path="../.."
}

configuration "unittest" {
    dependency "sparkles:test-runner" path="../.."
    dependency "sparkles:core-cli" path="../.."
    dependency "sparkles:test-utils" path="../.."

    dflags "-checkaction=context" "-allinst"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
