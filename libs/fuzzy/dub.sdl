name "fuzzy"
description "Bounded allocation-free fuzzy query, matching, ranking, and history engine"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetPath "build"
// The marker-only benchmark UDA must remain resolvable when a parent package
// enables unittests while selecting this package's library configuration.
importPaths "src" "../test-runner/src"

dflags "-preview=in" "-preview=dip1000"

dependency "expected" version="~>0.4.1"

configuration "library" {
    targetType "library"
    dependency "sparkles:base" path="../.."
}

configuration "unittest" {
    // Cycle-safe path: `sparkles:ui` depends on this package (the property
    // tree's search projection), and `ui` is in the impl library's dependency
    // closure (impl -> ui), so a `dependency` on the runner shim would close
    // `ui -> fuzzy -> test-runner -> impl -> ui`. Source-include the shim and
    // the impl instead, as `base`/`core-cli`/`test-utils`/`ui` do for the
    // same reason.
    sourcePaths "../test-runner/src" "../test-runner-impl/src"
    importPaths "src" "../test-runner/src" "../test-runner-impl/src"
    dependency "sparkles:base" path="../.."

    dflags "-checkaction=context" "-allinst"
}

// Linux release audit: the test module wraps the libc allocation family and
// compares druntime's per-thread GC counter around one complete keystroke.
// Keeping this separate avoids imposing GNU ld's --wrap on library consumers.
configuration "allocation-audit" {
    targetType "library"
    // The same cycle-safe runner integration as the unittest configuration.
    sourcePaths "../test-runner/src" "../test-runner-impl/src"
    importPaths "src" "../test-runner/src" "../test-runner-impl/src"
    dependency "sparkles:base" path="../.."

    versions "FuzzyAllocationAudit"
    dflags "-checkaction=context" "-allinst"
    lflags "--wrap=malloc" "--wrap=calloc" "--wrap=realloc" platform="linux"
}

// BEGIN managed build types — apps/ci/tools/standardize-build-settings.d
dflags "--linker=lld" platform="linux-ldc"
dflags "-L-fuse-ld=lld" platform="linux-dmd"

buildType "unittest" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-debug" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov" {
    buildOptions "unittests" "coverage" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov-ctfe" {
    buildOptions "unittests" "coverageCTFE" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
buildType "bench" {
    buildOptions "unittests" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-unchecked" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-static" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "--link-defaultlib-shared=false" platform="linux-ldc"
    dflags "-defaultlib=libphobos2.a" platform="linux-dmd"
    lflags "--export-dynamic" platform="linux-ldc"
}
// END managed build types
