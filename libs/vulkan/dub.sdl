name "vulkan"
description "Vulkan bindings: ImportC over the real headers, plus branded handles, Expected-typed results and per-device dispatch"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetPath "build"

dflags "-preview=in" "-preview=dip1000"

// Resolved through pkg-config: `vulkan.pc` (from vulkan-loader's `.dev`
// output) supplies both the link flags and — prefixed `-P-I` by dub — the
// ImportC include path for `<vulkan/vulkan.h>`. vulkan-headers ships no `.pc`
// of its own, which is why the loader's is the one named here.
//
// The link is nearly vestigial: `c.c` defines `VK_NO_PROTOTYPES`, so every
// entry point is reached through a function pointer and this object file has
// no undefined `vk*` symbols at all. It stays because dub ties the pkg-config
// `--cflags` lookup to a `libs` entry, and because `--as-needed` drops the
// unused DT_NEEDED anyway.
libs "vulkan"

dependency "expected" version="~>0.4.1"

// `sparkles:base` for the text primitives this binding builds on: the
// duplicate-tolerant enum naming in `sparkles.base.text.enums` (ImportC turns
// Vulkan's promoted-extension aliases into duplicate-valued members, which the
// `final switch` in `enumMemberName` rejects) and `sparkles.base.text.cstring`
// for handing C a NUL-terminated string without the GC. Both were open-coded
// in `libs/vulkan/examples/vulkaninfo.d` before they lived here.
//
// This and `expected` are the whole D dependency floor; keep it that way.
dependency "sparkles:base" path="../.."

configuration "library" {
    // `sourceLibrary`, not `library`: dub skips pkg-config for `library` and
    // `staticLibrary` targets, so the ImportC include path would never reach
    // the compiler. See docs/guidelines/importc-c-libraries.md.
    targetType "sourceLibrary"
}

configuration "unittest" {
    dependency "sparkles:test-runner" path="../.."

    dflags "-checkaction=context" "-allinst"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
// Optimised, assertions live, `debug {}` blocks out — the build every nix
// artifact uses. Neither `debug` (which compiles those blocks in) nor
// `release` (which deletes assert *expressions*, side effects included).
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
