name "vulkan-wsi"
description "Native sparkles:wsi to Vulkan surface and presentation bridge"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetPath "../../build"
targetType "sourceLibrary"

dflags "-preview=in" "-preview=dip1000"

// The source-imported Vulkan ABI still needs the target header include path.
// `vulkan.pc` supplies it as well as the loader link used by the smoke tests.
libs "vulkan"

// The test pattern's SPIR-V, committed beside its GLSL, which carries the
// regeneration command.
stringImportPaths "src/shaders"

dependency "expected" version="~>0.4.1"
dependency "sparkles:shaders" path="../.."
dependency "sparkles:vulkan" path="../.."
dependency "sparkles:wsi" path="../.."

configuration "library" {
    // ImportC needs `vulkan.pc`'s `-I`; dub skips pkg-config for static
    // libraries, so follow `sparkles:vulkan` and distribute source here.
    targetType "sourceLibrary"
}

// The library plus the triangle renderer (`SparklesVulkanWsiTriangle`), whose
// shaders are D (`triangle_shader.d`). Opt-in, because generating their
// SPIR-V takes the dcompute-enabled LDC (`ldc2-vulkan`), and the default
// build must need no compiler but its own. The triangle examples select it.
//
// The pre-generate step compiles the `shaders` configuration below to SPIR-V
// in `generated/shaders/` (git-ignored) and is a no-op while its stamp is
// fresh. `--temp-build` keeps concurrent dependents from racing on the tool's
// build.
configuration "gpu-shaders" {
    targetType "sourceLibrary"
    versions "SparklesVulkanWsiTriangle"
    stringImportPaths "generated/shaders"
    preGenerateCommands "$DUB run --temp-build -q --root=$PACKAGE_DIR/../../apps/shader-compile -- --package=$PACKAGE_DIR --out=$PACKAGE_DIR/generated/shaders --if-stale"
}

configuration "unittest" {
    // The block readback's probe module, compiled for the host so the test and
    // the device read one `Probe` (`tests/block-readback/`).
    sourcePaths "src" "tests/block-readback/src"
    importPaths "src" "tests/block-readback/src"
    versions "VulkanWsiBlockProbe"

    dependency "sparkles:test-runner" path="../.."

    dflags "-checkaction=context" "-allinst"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}

// The device build: what LDC's dcompute target compiles for the GPU. Never
// built by dub — `shader-compile` asks `dub describe` for it and compiles the
// `@compute` modules among its sources (`triangle_shader.d`, with
// `sparkles:shaders`'s).
configuration "shaders" {
    targetType "library"
    dflags "-mdcompute-targets=vulkan-130"
}

buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
