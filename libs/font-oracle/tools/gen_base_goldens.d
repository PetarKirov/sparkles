#!/usr/bin/env dub
/+ dub.sdl:
    name "gen_base_goldens"
    buildType "checked" {
        buildOptions "optimize" "inline" "debugInfo"
    }
+/
/**
Records fontTools' reading of every `BASE` table of the bundle and the test
corpus, which `oracle.baseline.agreesWithFontTools` compares the library's
reading with (testing.md § Metrics, FTM7, FTM22–FTM24): the tags, scripts,
default indices, coordinate formats, languages and MinMax records that
HarfBuzz and fontations resolve but do not report.

Run inside the dev shell with fontTools' `ttx` on `PATH`:

    nix shell --inputs-from . nixpkgs#python3Packages.fonttools \
        -c dub run --single libs/font-oracle/tools/gen_base_goldens.d

It writes `libs/font-oracle/test/goldens/base.txt`: a header naming the
reader, then per face with a `BASE` table its corpus name, SHA-256 and table
version, and per axis (`H`, `V`) these lines, a space inside a tag written
as `_`:

$(UL
    $(LI `axis <H|V> tags <tag>...`, or `notags` without a BaseTagList;)
    $(LI `script <axis> <tag> values <defaultIndex> <coord>...`, or
        `novalues` without BaseValues;)
    $(LI `minmax <axis> <script> default|language <tag> [feature <tag>]
        min <coord> max <coord>`: each MinMax record, then each of its
        FeatMinMax records, `-` for a null offset.)
)

A coordinate is `<format>:<value>`, then `:<glyph>:<point>` for format 2
and `+d` when a Device or VariationIndex table is attached. A collection
stands for its first face.
*/
module gen_base_goldens;

import std.algorithm : endsWith, sort;
import std.array : appender, array, join, replace;
import std.conv : to;
import std.digest : LetterCase, toHexString;
import std.digest.sha : sha256Of;
import std.exception : enforce;
import std.file : dirEntries, exists, read, SpanMode, write;
import std.format : formattedWrite;
import std.path : baseName, buildPath;
import std.process : environment, execute;
import std.regex : ctRegex, matchFirst;
import std.string : indexOf, lineSplitter, strip;

void main()
{
    const bundle = environment.get("SPARKLES_FONTS_PATH");
    const test = environment.get("SPARKLES_FONT_TEST_CORPUS");
    enforce(bundle !is null && test !is null,
        "SPARKLES_FONTS_PATH or SPARKLES_FONT_TEST_CORPUS is unset: enter the dev shell");
    const version_ = execute(["ttx", "--version"]);
    enforce(version_.status == 0, "ttx is not on PATH: run under nix shell nixpkgs#python3Packages.fonttools");

    string[string] files; // name in the golden -> path
    void add(string prefix, string dir)
    {
        if (!dir.exists)
            return;
        foreach (e; dirEntries(dir, SpanMode.shallow))
            if (e.name.endsWith(".ttf") || e.name.endsWith(".otf") || e.name.endsWith(".ttc"))
                files[prefix ~ e.name.baseName] = e.name;
    }
    add("bundle/", bundle);
    add("test/", test);
    foreach (sub; ["base", "math", "harfbuzz"])
        add("test/" ~ sub ~ "/", buildPath(test, sub));

    auto out_ = appender!string;
    out_.put("# Generated by libs/font-oracle/tools/gen_base_goldens.d; do not edit.\n");
    out_.formattedWrite("# reader fontTools %s (ttx -t GlyphOrder -t BASE)\n", version_.output.strip);
    auto names = files.keys;
    names.sort;
    foreach (name; names)
    {
        const path = files[name];
        const listing = execute(["ttx", "-q", "-y", "0", "-l", path]);
        if (listing.status != 0 || listing.output.indexOf("BASE ") < 0)
            continue;
        const dump = execute(["ttx", "-q", "-y", "0", "-o", "-", "-t", "GlyphOrder", "-t", "BASE", path]);
        enforce(dump.status == 0, "ttx failed on " ~ path ~ "\n" ~ dump.output);
        out_.formattedWrite("face %s sha256 %s", name,
            toHexString!(LetterCase.lower)(sha256Of(cast(const(ubyte)[]) read(path))));
        writeBase(out_, dump.output, name);
    }
    write("libs/font-oracle/test/goldens/base.txt", out_.data);
}

/// A tag as the golden spells it: a space as `_`.
string tag(string t) => t.replace(" ", "_");

/// The lines of one `BASE` dump, after the face line's version.
void writeBase(Out)(ref Out out_, string xml, string face)
{
    static attr = ctRegex!`<(\w+)(?: index="\d+")?(?: Format="(\d)")?(?: value="([^"]*)")?\s*/?>`;
    static glyphId = ctRegex!`<GlyphID id="(\d+)" name="([^"]+)"/>`;

    uint[string] ids;
    string axis, script, language, feature;
    string[] tags, coords;
    string defaultIndex, minCoord = "-", maxCoord = "-";
    bool sawTags;
    // The coordinate being read: which slot it fills, its format, value, glyph and point.
    string slot, format, value, glyph, point;
    bool device;
    string minMaxOwner; // "default" or "language <tag>" of the MinMax being read
    bool hasValues, recordWritten;

    void endCoord()
    {
        auto c = format ~ ":" ~ value;
        if (format == "2")
        {
            enforce(glyph in ids, face ~ ": reference glyph " ~ glyph ~ " is not in the glyph order");
            c ~= ":" ~ ids[glyph].to!string ~ ":" ~ point;
        }
        if (device)
            c ~= "+d";
        if (slot == "value")
            coords ~= c;
        else if (slot == "min")
            minCoord = c;
        else
            maxCoord = c;
        slot = null;
    }
    void emitMinMax()
    {
        out_.formattedWrite("minmax %s %s %s%s min %s max %s\n", axis, tag(script), minMaxOwner,
            feature is null ? "" : " feature " ~ tag(feature), minCoord, maxCoord);
        minCoord = maxCoord = "-";
    }

    foreach (raw; xml.lineSplitter)
    {
        const line = raw.strip;
        if (auto m = line.matchFirst(glyphId))
        {
            ids[m[2]] = m[1].to!uint;
            continue;
        }
        if (line.indexOf("<Version ") == 0)
        {
            out_.formattedWrite(" version %s\n", line.matchFirst(attr)[3]);
            continue;
        }
        if (line == "<HorizAxis>" || line == "<VertAxis>")
        {
            axis = line == "<HorizAxis>" ? "H" : "V";
            tags = null;
            sawTags = false;
            continue;
        }
        if (line == "</BaseTagList>" || line == "<BaseScriptList>")
        {
            if (!sawTags && line == "<BaseScriptList>")
                out_.formattedWrite("axis %s notags\n", axis);
            else if (line == "</BaseTagList>")
                out_.formattedWrite("axis %s tags %s\n", axis, tags.join(" "));
            continue;
        }
        if (line == "<BaseValues>")
        {
            coords = null;
            continue;
        }
        if (line == "<BaseScript>")
        {
            hasValues = false;
            continue;
        }
        if (line == "</BaseValues>")
        {
            out_.formattedWrite("script %s %s values %s %s\n", axis, tag(script), defaultIndex, coords.join(" "));
            hasValues = true;
            continue;
        }
        if (line == "</BaseScript>")
        {
            if (!hasValues)
                out_.formattedWrite("script %s %s novalues\n", axis, tag(script));
            continue;
        }
        // A MinMax record: its own extents, then each FeatMinMax record's.
        if (line == "<DefaultMinMax>" || line == "<MinMax>")
        {
            if (line == "<DefaultMinMax>")
                minMaxOwner = "default";
            feature = null;
            recordWritten = false;
            minCoord = maxCoord = "-";
            continue;
        }
        if (line.indexOf("<FeatMinMaxRecord") == 0)
        {
            if (!recordWritten)
                emitMinMax();
            recordWritten = true;
            continue;
        }
        if (line == "</FeatMinMaxRecord>")
        {
            emitMinMax();
            feature = null;
            continue;
        }
        if (line == "</DefaultMinMax>" || line == "</MinMax>")
        {
            if (!recordWritten)
                emitMinMax();
            continue;
        }
        if (line == "<DeviceTable>")
        {
            device = true;
            continue;
        }
        if (line == "</BaseCoord>" || line == "</MinCoord>" || line == "</MaxCoord>")
        {
            endCoord();
            continue;
        }
        const m = line.matchFirst(attr);
        if (m.empty)
            continue;
        switch (m[1])
        {
            case "BaselineTag":
                tags ~= tag(m[3]);
                sawTags = true;
                break;
            case "BaseScriptTag":
                script = m[3];
                break;
            case "BaseLangSysTag":
                minMaxOwner = "language " ~ tag(m[3]);
                feature = null;
                break;
            case "FeatureTableTag":
                feature = m[3];
                break;
            case "DefaultIndex":
                defaultIndex = m[3];
                break;
            case "BaseCoord", "MinCoord", "MaxCoord":
                slot = m[1] == "BaseCoord" ? "value" : m[1] == "MinCoord" ? "min" : "max";
                format = m[2];
                device = false;
                break;
            case "Coordinate":
                value = m[3];
                break;
            case "ReferenceGlyph":
                glyph = m[3];
                break;
            case "BaseCoordPoint":
                point = m[3];
                break;
            default:
                break;
        }
    }
}
