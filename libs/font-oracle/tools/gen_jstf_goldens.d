#!/usr/bin/env dub
/+ dub.sdl:
    name "gen_jstf_goldens"
    buildType "checked" {
        buildOptions "optimize" "inline" "debugInfo"
    }
+/
/**
Records fontTools' reading of each `JSTF` table in the unfree corpus
(`nix/packages/font-unfree-corpus.nix`), which `oracle.jstf.agreesWithFontTools`
compares the library's reading with (testing.md § Shaping, FTS11): a reader
written apart from this library, so it checks the parser, not a fixture.

Run inside the dev shell with fontTools' `ttx` on `PATH`:

    SPARKLES_FONT_UNFREE_CORPUS=$(nix build --no-link --print-out-paths \
        .#sparkles-font-unfree-corpus) \
    nix shell --inputs-from . nixpkgs#python3Packages.fonttools \
        -c dub run --single libs/font-oracle/tools/gen_jstf_goldens.d

It writes `libs/font-oracle/test/goldens/jstf.txt`: a header naming the
reader, then per face its SHA-256 and one line per script — its tag, its
extender glyphs as glyph ids, whether it has a default language system and
how many language systems it lists.

The corpus's records hold scripts and extender glyphs only. Priority
records are refused: the oracle compares none, and the generator and the
oracle grow that support together, once a face can test it.
*/
module gen_jstf_goldens;

import std.algorithm : sort;
import std.array : appender, array;
import std.conv : to;
import std.digest : toHexString, LetterCase;
import std.digest.sha : sha256Of;
import std.exception : enforce;
import std.file : dirEntries, read, SpanMode, write;
import std.format : formattedWrite;
import std.path : baseName;
import std.process : environment, execute;
import std.regex : ctRegex, matchFirst;
import std.string : lineSplitter, strip;

void main()
{
    const corpus = environment.get("SPARKLES_FONT_UNFREE_CORPUS");
    enforce(corpus !is null, "SPARKLES_FONT_UNFREE_CORPUS is unset: build .#sparkles-font-unfree-corpus");
    const version_ = execute(["ttx", "--version"]);
    enforce(version_.status == 0, "ttx is not on PATH: run under nix shell nixpkgs#python3Packages.fonttools");

    auto out_ = appender!string;
    out_.put("# Generated by libs/font-oracle/tools/gen_jstf_goldens.d; do not edit.\n");
    out_.formattedWrite("# reader fontTools %s (ttx -t GlyphOrder -t JSTF)\n", version_.output.strip);
    auto faces = dirEntries(corpus, "*.ttf", SpanMode.shallow).array;
    faces.sort!((a, b) => a.name < b.name);
    foreach (face; faces)
    {
        const bytes = cast(const(ubyte)[]) read(face.name);
        out_.formattedWrite("face %s sha256 %s\n", face.name.baseName,
            toHexString!(LetterCase.lower)(sha256Of(bytes)));
        const dump = execute(["ttx", "-q", "-o", "-", "-t", "GlyphOrder", "-t", "JSTF", face.name]);
        enforce(dump.status == 0, "ttx failed on " ~ face.name ~ "\n" ~ dump.output);
        writeScripts(out_, dump.output, face.name);
    }
    write("libs/font-oracle/test/goldens/jstf.txt", out_.data);
}

/// One `script` line per `JstfScriptRecord` of a `ttx` dump.
void writeScripts(Out)(ref Out out_, string xml, string face)
{
    static glyphId = ctRegex!`<GlyphID id="(\d+)" name="([^"]+)"/>`;
    static scriptTag = ctRegex!`<JstfScriptTag value="(.{4})"/>`;
    static extender = ctRegex!`<ExtenderGlyph index="\d+" value="([^"]+)"/>`;
    static langSysCount = ctRegex!`<!-- JstfLangSysCount=(\d+) -->`;

    uint[string] ids;
    string script;
    uint[] extenders;
    bool hasDefault;
    void flush(uint languages)
    {
        out_.formattedWrite("script %s extenders", script);
        foreach (g; extenders)
            out_.formattedWrite(" %s", g);
        out_.formattedWrite(" default %s languages %s\n", hasDefault ? "present" : "absent", languages);
        script = null;
        extenders = null;
        hasDefault = false;
    }
    foreach (line; xml.lineSplitter)
    {
        if (auto m = line.matchFirst(glyphId))
            ids[m[2]] = m[1].to!uint;
        else if (auto m = line.matchFirst(scriptTag))
            script = m[1];
        else if (auto m = line.matchFirst(extender))
        {
            enforce(m[1] in ids, face ~ ": extender " ~ m[1] ~ " is not in the glyph order");
            extenders ~= ids[m[1]];
        }
        else if (auto m = line.matchFirst(langSysCount))
        {
            enforce(script !is null, face ~ ": a language-system count outside a script");
            flush(m[1].to!uint);
        }
        else if (line.strip == "<DefJstfLangSys>")
            hasDefault = true;
        enforce(matchFirst(line, ctRegex!`<JstfPriority[ >]`).empty,
            face ~ ": priority records are not compared yet; extend this tool and the oracle together");
    }
}
