#!/usr/bin/env dub
/+ dub.sdl:
    name "gen_shaping_goldens"
    buildType "checked" {
        buildOptions "optimize" "inline" "debugInfo"
    }
+/
/**
Records `hb-shape` output for the fixed strings of testing.md § Shaping
(FTS1), which `oracle.shaping.hbShapeGoldens` compares the library's
shaper with: a separate call path through the same pinned engine, so it
checks the wrapper, not the engine.

Run inside the dev shell, whose `hb-shape` is the pinned HarfBuzz:

    dub run --single libs/font-oracle/tools/gen_shaping_goldens.d

It writes `libs/font-oracle/test/goldens/shaping.txt`: a header naming
the engine and each face's SHA-256, then one case per line followed by
`hb-shape`'s JSON output.
*/
module gen_shaping_goldens;

import std.array : appender, join;
import std.digest : toHexString, LetterCase;
import std.digest.sha : sha256Of;
import std.exception : enforce;
import std.file : read, write;
import std.format : formattedWrite;
import std.path : buildPath;
import std.process : environment, execute;
import std.string : strip;

/// One shaping case: a face, an instance, segment properties and text.
struct Case
{
    string face, variations, direction, script, language, text;
}

immutable Case[] cases = [
    Case("MapleMono-NF-CN-Regular.ttf", "", "ltr", "latn", "en", "a != b -> c ==> www"),
    Case("NotoSans.ttf", "wght=300", "ltr", "latn", "en", "office Wavy AVA Ta fi"),
    Case("NotoSans.ttf", "wght=800", "ltr", "latn", "en", "office Wavy AVA Ta fi"),
    Case("NotoSansArabic.ttf", "", "rtl", "arab", "ar", "سلام عليكم"),
    Case("NotoSansDevanagari.ttf", "", "ltr", "deva", "hi", "क्षत्रिय हिन्दी"),
];

void main()
{
    const fonts = environment.get("SPARKLES_FONTS_PATH");
    enforce(fonts !is null, "run inside the dev shell: SPARKLES_FONTS_PATH is unset");
    const version_ = execute(["hb-shape", "--version"]);
    enforce(version_.status == 0, "hb-shape is not on PATH");

    auto out_ = appender!string;
    out_.put("# Generated by libs/font-oracle/tools/gen_shaping_goldens.d; do not edit.\n");
    out_.formattedWrite("# engine %s\n", version_.output.strip.splitFirstLine);
    out_.put("# options --output-format=json --no-glyph-names --utf8-clusters --cluster-level=1 --bot --eot\n");
    string[] seen;
    foreach (c; cases)
    {
        bool known;
        foreach (s; seen)
            known |= s == c.face;
        if (known)
            continue;
        seen ~= c.face;
        const digest = sha256Of(cast(const(ubyte)[]) read(buildPath(fonts, c.face)));
        out_.formattedWrite("# face %s sha256 %s\n", c.face, toHexString!(LetterCase.lower)(digest));
    }
    foreach (c; cases)
    {
        string[] args = ["hb-shape", "--output-format=json", "--no-glyph-names", "--utf8-clusters", "--cluster-level=1",
            "--bot", "--eot", "--direction=" ~ c.direction, "--script=" ~ c.script,
            "--language=" ~ c.language];
        if (c.variations.length)
            args ~= "--variations=" ~ c.variations;
        args ~= [buildPath(fonts, c.face), c.text];
        const r = execute(args);
        enforce(r.status == 0, "hb-shape failed: " ~ args.join(" ") ~ "\n" ~ r.output);
        out_.formattedWrite("case\t%s\t%s\t%s\t%s\t%s\t%s\n", c.face, c.variations.length ? c.variations : "-",
            c.direction, c.script, c.language, c.text);
        out_.formattedWrite("%s\n", r.output.strip);
    }
    write("libs/font-oracle/test/goldens/shaping.txt", out_.data);
}

private string splitFirstLine(string s)
{
    foreach (i, ch; s)
        if (ch == '\n')
            return s[0 .. i];
    return s;
}
