name "font-oracle"
description "Test-only: sparkles:font checked against HarfBuzz over the bundled fonts"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetPath "build"

importPaths "src"

dflags "-preview=in" "-preview=dip1000"

dependency "expected" version="~>0.4.1"

// HarfBuzz is the oracle, declared by ImportC from its installed headers
// (src/sparkles/font_oracle/harfbuzz_c.c); pkg-config supplies both the link
// flags and the header path. It is linked here, never by sparkles:font's
// pure-D library configuration (FTA7).
libs "harfbuzz"

// The shim only declares; its symbols come from libharfbuzz. Compiling it as a
// root source would give it the bare module name `harfbuzz_c`.
excludedSourceFiles "src/sparkles/font_oracle/harfbuzz_c.c"

configuration "library" {
    // ImportC needs pkg-config's include flags, which dub applies only where
    // the package is compiled into an executable.
    targetType "sourceLibrary"
    dependency "sparkles:font" path="../.."
    dependency "sparkles:base" path="../.."
}

configuration "unittest" {
    dependency "sparkles:test-runner" path="../.."
    dependency "sparkles:font" path="../.."
    dependency "sparkles:base" path="../.."

    // The differential suite exists only for tests.
    sourcePaths "src" "test"
    importPaths "src" "test"

    dflags "-checkaction=context" "-allinst"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
// Optimised, assertions live, `debug {}` blocks out — the build every nix
// artifact uses. Neither `debug` (which compiles those blocks in) nor
// `release` (which deletes assert *expressions*, side effects included).
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
