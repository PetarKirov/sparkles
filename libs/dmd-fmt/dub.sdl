name "dmd-fmt"
description "D formatter on the DMD-lexer token spine (dmd-fmt proposal M0/M1)"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetPath "build"
importPaths "src"

// The token spine needs only dmd:lexer — and keeping the hot dependency
// lexer-only is a bet the proposal records under the fork-treadmill failure
// mode (the lexer churns far less than the AST). The fork's dmd:lexer now
// carries astenums.d and rootobject.d so it links standalone (the M0-S1
// packaging finding, fixed fork-side; tracked in the fork's
// PLAN-UPSTREAMING.md). The AST-oracle milestones (S2/S4, M3) will add
// dmd:frontend when they land. Same pin as libs/dmd-lsp — see
// docs/specs/dmd-lsp/ (BLD1/BLD2) for the pin and upgrade procedure.
dependency "dmd:lexer" repository="git+https://github.com/PetarKirov/dmd.git" \
    version="c562711dbd4685c4e4f7bd5ff46e1a306c932259"

// Deliberately NO -preview=in / -preview=dip1000 (the repo standard): the
// dmd.* module interfaces this package imports are not dip1000-clean — the
// same reasoning as libs/dmd-lsp (BLD4).

// Optimized with assertions kept — the build to use for anything linking the
// DMD frontend, which relies on its asserts to catch a fork that has drifted.
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}

configuration "library" {
    targetType "library"
}

configuration "unittest" {
    // Fast path: depend on the runner shim (pulls the prebuilt impl library),
    // so `dub test` recompiles only this package, not the runner sources.
    dependency "sparkles:test-runner" path="../.."

    // Same link setup as libs/dmd-lsp's unittest configuration (the frontend
    // archive is large; no -checkaction=context for the same reason — it
    // leaks into the dmd:frontend compilation and fails to link).
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
