name "dmd-fmt"
description "D formatter on the DMD-lexer token spine (dmd-fmt proposal M0/M1)"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetPath "build"
importPaths "src"

// The token spine (spine.d — the formatter's hot path) needs only
// dmd:lexer, which links standalone since the fork's packaging fix (the
// M0-S1 finding; tracked in the fork's PLAN-UPSTREAMING.md). That matters
// for the fork-treadmill bet the proposal records: the lexer churns far
// less than the AST. The S2/S4 AST oracle (oracle.d, M3's seed) needs
// dmd:frontend — parse-only, never fullSemantic. Same pin as libs/dmd-lsp —
// see docs/specs/dmd-lsp/ (BLD1/BLD2) for the pin and upgrade procedure.
dependency "dmd:lexer" repository="git+https://github.com/PetarKirov/dmd.git" \
    version="e0be436ba491e506552e529a6a10983a436898e5"
// The edit vocabulary (`sparkles.base.text.edits`) the formatter reports in.
dependency "sparkles:base" path="../.."
dependency "sparkles:diff" path="../.."
// The case runner's failure report only: `drawBox` frames each pane and
// `hjoin` puts them in columns (cases.d). The formatter itself never draws.
dependency "sparkles:ui" path="../.."
dependency "dmd:frontend" repository="git+https://github.com/PetarKirov/dmd.git" \
    version="e0be436ba491e506552e529a6a10983a436898e5"

// Deliberately NO -preview=in / -preview=dip1000 (the repo standard): the
// dmd.* module interfaces this package imports are not dip1000-clean — the
// same reasoning as libs/dmd-lsp (BLD4).

// Optimized with assertions kept — the build to use for anything linking the
// DMD frontend, which relies on its asserts to catch a fork that has drifted.

// The optimized unittest/benchmark build — `checked`'s philosophy (asserts
// alive, never -release) plus the unittest machinery. dub resolves --build
// against the ROOT package, so run it from this directory:
//     dub test --build=unittest-checked -- --bench
buildType "unittest-checked" {
    buildOptions "unittests" "optimize" "inline" "debugInfo"
    // Assertion-enabled frontend benchmark; preserve its existing link policy.
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}

configuration "library" {
    targetType "library"
}

// The dmd-fmt command (cli.d is version(DmdFmtCli)-gated, so the library
// and unittest configurations compile it as empty):
//     dub build :dmd-fmt --config=cli
//     ./libs/dmd-fmt/build/dmd-fmt --check FILE...   # exit 1 = unformatted
configuration "cli" {
    targetType "executable"
    targetName "dmd-fmt"
    versions "DmdFmtCli"
}

configuration "unittest" {
    // Fast path: depend on the runner shim (pulls the prebuilt impl library),
    // so `dub test` recompiles only this package, not the runner sources.
    dependency "sparkles:test-runner" path="../.."
    // Scratch trees for the `.editorconfig` discovery walk and the case
    // runner's failure artifacts. Test-only: never a library dependency.
    dependency "sparkles:test-utils" path="../.."

    // Same link setup as libs/dmd-lsp's unittest configuration (the frontend
    // archive is large; no -checkaction=context for the same reason — it
    // leaks into the dmd:frontend compilation and fails to link).
}

// BEGIN managed build types — apps/ci/tools/standardize-build-settings.d
dflags "--linker=lld" platform="linux-ldc"
dflags "-L-fuse-ld=lld" platform="linux-dmd"

buildType "unittest" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-debug" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov" {
    buildOptions "unittests" "coverage" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov-ctfe" {
    buildOptions "unittests" "coverageCTFE" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
buildType "bench" {
    buildOptions "unittests" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-unchecked" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-static" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "--link-defaultlib-shared=false" platform="linux-ldc"
    dflags "-defaultlib=libphobos2.a" platform="linux-dmd"
    lflags "--export-dynamic" platform="linux-ldc"
}
// END managed build types
