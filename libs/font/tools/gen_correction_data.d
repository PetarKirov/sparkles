#!/usr/bin/env dub
/+ dub.sdl:
    name "gen_correction_data"
+/
/**
Generates `libs/font/src/sparkles/font/correction_data.d`, the data of the
correction registry (FTD10–FTD12, `docs/specs/font/discovery.md` § 8), from
the engines' own sources:

$(UL
    $(LI HarfBuzz's `GDEF` blocklist, from `src/hb-ot-layout.cc`;)
    $(LI HarfBuzz's legacy Arabic code pages, from `src/ArabicPUASimplified.txt`
        and `src/ArabicPUATraditional.txt`, read as `gen-arabic-pua.py` reads
        them: one entry per Unicode scalar, the last row winning;)
    $(LI FreeType's tricky fonts, from `src/truetype/ttobjs.c`.)
)

Usage, from the repository root inside the dev shell:

---
dub run --single libs/font/tools/gen_correction_data.d -- \
    "$SPARKLES_FLAKE_INPUT_HARFBUZZ_SRC" <freetype-2.14.3 source> \
    > libs/font/src/sparkles/font/correction_data.d
---

The FreeType tree is the pinned release's tarball, unpacked; the font tests
check the HarfBuzz tables against `$SPARKLES_FLAKE_INPUT_HARFBUZZ_SRC`
again, and the oracle checks the FreeType ones with `FT_IS_TRICKY`.
*/
module gen_correction_data;

import std.algorithm : canFind, findSplitAfter, sort, startsWith;
import std.array : array;
import std.conv : to;
import std.file : readText;
import std.format : format;
import std.path : buildPath;
import std.regex : ctRegex, matchAll, matchFirst;
import std.stdio : stderr, writef, writefln, writeln;
import std.string : lineSplitter, strip;

int main(string[] args)
{
    if (args.length != 3)
    {
        stderr.writeln("usage: gen_correction_data <harfbuzz source> <freetype source>");
        return 2;
    }
    const hb = args[1], ft = args[2];

    const gdef = gdefBlocklist(readText(buildPath(hb, "src", "hb-ot-layout.cc")));
    const simplified = puaMap(readText(buildPath(hb, "src", "ArabicPUASimplified.txt")));
    const traditional = puaMap(readText(buildPath(hb, "src", "ArabicPUATraditional.txt")));
    const ttobjs = readText(buildPath(ft, "src", "truetype", "ttobjs.c"));
    const names = trickyNames(ttobjs);
    const ids = trickySfntIds(ttobjs);

    writeln(`/**
The data of the correction registry (FTD10–FTD12), generated by
` ~ "`libs/font/tools/gen_correction_data.d`" ~ ` from HarfBuzz 14.6.0
(` ~ "`src/hb-ot-layout.cc`, `src/ArabicPUASimplified.txt`, `src/ArabicPUATraditional.txt`" ~ `)
and FreeType 2.14.3 (` ~ "`src/truetype/ttobjs.c`" ~ `). Do not edit.
*/
module sparkles.font.correction_data;

package:

/// The lengths of ` ~ "`GDEF`, `GSUB` and `GPOS`" ~ ` that HarfBuzz ignores ` ~ "`GDEF`" ~ ` for, sorted.
struct GdefLengths
{
    uint gdef, gsub, gpos;
}

/// ditto
immutable GdefLengths[] gdefBlocklist = [`);
    foreach (t; gdef)
        writefln("    GdefLengths(%s, %s, %s),", t[0], t[1], t[2]);
    writeln(`];

/// A Unicode scalar and the private-use code a legacy Arabic page gives it.
struct PuaPair
{
    ushort unicode, pua;
}
`);
    emitPua("Simplified Arabic (`fsSelection` high byte `0xB2`), sorted by scalar.",
        "arabicPuaSimplified", simplified);
    emitPua("Traditional Arabic (`fsSelection` high byte `0xB3`), sorted by scalar.",
        "arabicPuaTraditional", traditional);

    writeln("/// FreeType's tricky family names, matched as substrings.");
    writeln("immutable string[] trickyNames = [");
    foreach (n; names)
        writefln("    %s,", n);
    writeln("];\n");
    writeln(`/// One table of a tricky face: its checksum and length; length 0 matches a missing table.
struct TrickyTable
{
    uint checksum, length;
}

/// FreeType's tricky faces by ` ~ "`cvt `, `fpgm` and `prep`" ~ `, in that order.
immutable TrickyTable[3][] trickyTables = [`);
    foreach (face; ids)
        writefln("    [TrickyTable(0x%08X, 0x%X), TrickyTable(0x%08X, 0x%X), TrickyTable(0x%08X, 0x%X)],",
            face[0][0], face[0][1], face[1][0], face[1][1], face[2][0], face[2][1]);
    writeln("];");
    return 0;
}

/// The `case HB_CODEPOINT_ENCODE3 (a, b, c):` triples of `GDEF::is_blocklisted`.
uint[3][] gdefBlocklist(string source)
{
    auto body = source.findSplitAfter("OT::GDEF::is_blocklisted")[1];
    body = body[0 .. body.findSplitAfter("return false;\n}")[0].length];
    uint[3][] triples;
    foreach (m; body.matchAll(ctRegex!`case HB_CODEPOINT_ENCODE3 \((\d+), (\d+), (\d+)\):`))
        triples ~= [m[1].to!uint, m[2].to!uint, m[3].to!uint];
    triples.sort();
    assert(triples.length > 30, "the blocklist was not found");
    return triples;
}

/// The scalar → private-use map of a page, the last row winning, sorted by scalar.
ushort[2][] puaMap(string text)
{
    ushort[ushort] map;
    foreach (line; text.lineSplitter)
    {
        if (line.startsWith("#") || line.strip.length == 0)
            continue;
        auto m = line.matchFirst(ctRegex!`^0x([0-9A-Fa-f]+)\t0x([0-9A-Fa-f]+)`);
        assert(!m.empty, line);
        map[m[2].to!ushort(16)] = m[1].to!ushort(16);
    }
    auto pairs = map.byKeyValue.array;
    pairs.sort!((a, b) => a.key < b.key);
    ushort[2][] r;
    foreach (p; pairs)
        r ~= [p.key, p.value];
    return r;
}

void emitPua(string doc, string name, in ushort[2][] pairs)
{
    writefln("/// %s", doc);
    writefln("immutable PuaPair[] %s = [", name);
    foreach (i, p; pairs)
        writef("%sPuaPair(0x%04X, 0x%04X),%s", i % 4 == 0 ? "    " : " ", p[0], p[1],
            i % 4 == 3 || i + 1 == pairs.length ? "\n" : "");
    writeln("];\n");
}

/// The string literals of `trick_names`.
string[] trickyNames(string source)
{
    auto body = source.findSplitAfter("trick_names[TRICK_NAMES_COUNT]")[1];
    body = body[0 .. body.findSplitAfter("};")[0].length];
    string[] names;
    foreach (line; body.lineSplitter)
    {
        auto m = line.matchFirst(ctRegex!`^\s*("[^"]*"),`);
        if (!m.empty)
            names ~= m[1];
    }
    assert(names.length == 20, format("%s tricky names", names.length));
    return names;
}

/// The `sfnt_id` rows: per face, three (checksum, length) pairs.
uint[2][3][] trickySfntIds(string source)
{
    auto body = source.findSplitAfter("sfnt_id[TRICK_SFNT_IDS_NUM_FACES]")[1];
    body = body[0 .. body.findSplitAfter("\n    };")[0].length];
    uint[2][] pairs;
    foreach (m; body.matchAll(ctRegex!`\{ 0x([0-9A-F]+)UL, 0x([0-9A-F]+)UL \}`))
        pairs ~= [m[1].to!uint(16), m[2].to!uint(16)];
    assert(pairs.length == 31 * 3, format("%s sfnt id pairs", pairs.length));
    uint[2][3][] faces;
    for (size_t i = 0; i < pairs.length; i += 3)
        faces ~= [pairs[i], pairs[i + 1], pairs[i + 2]];
    return faces;
}
