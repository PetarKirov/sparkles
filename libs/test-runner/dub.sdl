name "test-runner"
description "General-purpose unittest runner with CTFE, betterC, wasm, and benchmark support"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetPath "build"

dflags "-preview=in" "-preview=dip1000"

// The registration shim: only `attributes` (the marker UDAs), `discovery`
// (compile-time reflection over the tested package's modules) and `register`
// (the druntime hook + a thin `extern(C)` seam) compile into each consumer's
// test binary. The heavy machinery lives in the prebuilt
// `sparkles:test-runner-impl` library, so a consumer's `dub test` stays close to
// a vanilla build — an external project pulls this package as one dependency and
// gets both automatically.
//
// The UDAs live here, not in the impl: a module carrying one imports them in
// every build, so only this package needs to be on a consumer's top-level
// `importPaths`.
//
// In-monorepo `base`/`core-cli` cannot depend on this package (dub rejects the
// resulting cycle: impl → base); they source-include both the shim and the impl
// in their `configuration "unittest"`.
//
// Every other in-monorepo consumer depends on this package like an external
// one (`dependency "sparkles:test-runner" path="../.."`).
dependency "sparkles:test-runner-impl" path="../.."

targetType "sourceLibrary"

configuration "library" {
    targetType "sourceLibrary"
}

// Forward the optimized consumer's choice to the implementation: DUB's
// subConfiguration directives only apply to direct dependencies.
configuration "benchmark" {
    targetType "sourceLibrary"
    subConfiguration "sparkles:test-runner-impl" "benchmark"
}

configuration "unittest" {
    // The shim's own tests (discovery) run through the linked impl library.
    targetType "library"

    dflags "-checkaction=context" "-allinst"
}

// BEGIN managed build types — apps/ci/tools/standardize-build-settings.d
buildType "unittest" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-debug" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov" {
    buildOptions "unittests" "coverage" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov-ctfe" {
    buildOptions "unittests" "coverageCTFE" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
buildType "bench" {
    buildOptions "unittests" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-unchecked" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-static" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "--link-defaultlib-shared=false" "--linker=gold" platform="linux-ldc"
    dflags "-defaultlib=libphobos2.a" "-L-fuse-ld=gold" platform="linux-dmd"
    lflags "--export-dynamic" platform="linux-ldc"
}
// END managed build types
