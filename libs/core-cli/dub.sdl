name "core-cli"
description "A library for CLI apps"
authors "Petar Kirov"
copyright "Copyright © 2021, Petar Kirov"
license "BSL-1.0"

dflags "-preview=in" "-preview=dip1000"

dependency "sparkles:base" path="../.."
dependency "expected" version="~>0.4.1"

// The UI components moved to the canvas-first toolkit; `core-cli` keeps
// command-line concerns and consumes them (prompts style their output with the
// theme and drive a live region). `sparkles:ui` takes the cycle-safe recipe
// precisely so this edge is legal — see `libs/ui/dub.sdl`.
dependency "sparkles:ui" path="../.."

targetType "library"
targetPath "build"

// `../math/src` is import-only (all-template `Vector`/`ScreenSize`): a real
// `dependency "sparkles:math"` would close a dub dependency cycle through
// math's unittest config (math -> test-runner -> test-runner-impl -> core-cli),
// the same reason the test-runner shim/impl are on importPaths here.
importPaths "src" "../test-runner/src" "../test-runner-impl/src" "../math/src"

configuration "library" {
    targetType "library"
    excludedSourceFiles "src/app.d"
}

configuration "unittest" {
    excludedSourceFiles "src/app.d"

    // `core-cli` is imported by the impl (UI niceties), so it cannot depend on
    // the impl library — it source-includes the shim and the impl instead.
    sourcePaths "../test-runner/src" "../test-runner-impl/src"
    dependency "sparkles:test-utils" path="../.."

    dflags "-checkaction=context" "-allinst"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
// Optimised, assertions live, `debug {}` blocks out — the build every nix
// artifact uses. Neither `debug` (which compiles those blocks in) nor
// `release` (which deletes assert *expressions*, side effects included).
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
