name "core-cli"
description "A library for CLI apps"
authors "Petar Kirov"
copyright "Copyright © 2021, Petar Kirov"
license "BSL-1.0"

dflags "-preview=in" "-preview=dip1000"

dependency "sparkles:test-attributes" path="../.."
dependency "sparkles:base" path="../.."
dependency "sparkles:metadata" path="../.."
dependency "sparkles:wired" path="../.."

targetType "library"
targetPath "build"

// For `Vector`/`ScreenSize`. math depends on `sparkles:base` alone, so this
// edge closes no cycle.
dependency "sparkles:math" path="../.."
importPaths "src"

// The UI components moved to the canvas-first toolkit; `core-cli` keeps
// command-line concerns and consumes them (prompts style their output with the
// theme and drive a live region). `sparkles:ui` does not depend on this
// package, so this edge closes no cycle.
configuration "library" {
    // Test-support modules: only the test root compiles them, so a
    // `version (unittest)` in them changes nothing a dependent sees
    // (build-graph BGV4).
    excludedSourceFiles "src/sparkles/core_cli/test_utils.d"
    targetType "library"
    dependency "sparkles:ui" path="../.."
}

// The argument parser and its help without the prompts, so a program can
// parse a command line without the UI toolkit (`fsx`, docs/specs/fsx `XA5`).
configuration "args" {
    targetType "library"
    // As the library configuration, the test-support module too (BGV4).
    excludedSourceFiles "src/sparkles/core_cli/prompts.d" "src/sparkles/core_cli/test_utils.d"
}

configuration "unittest" {
    dependency "sparkles:ui" path="../.."
    dependency "sparkles:test-utils" path="../.."

    dflags "-checkaction=context" "-allinst"
    dependency "sparkles:test-runner" path="../.."
}

// BEGIN managed build types — apps/ci/tools/standardize-build-settings.d
dflags "--linker=lld" platform="linux-ldc"
dflags "-L-fuse-ld=lld" platform="linux-dmd"

buildType "unittest" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-debug" {
    buildOptions "unittests" "debugMode" "debugInfo"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov" {
    buildOptions "unittests" "coverage" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "unittest-cov-ctfe" {
    buildOptions "unittests" "coverageCTFE" "debugMode" "debugInfo"
    dflags "--gline-tables-only" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
buildType "bench" {
    buildOptions "unittests" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-unchecked" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "-defaultlib=libphobos2.so" platform="linux-dmd"
    dflags "--link-defaultlib-shared" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
buildType "bench-static" {
    buildOptions "unittests" "releaseMode" "optimize" "inline"
    dflags "-mcpu=native" "-O3" "-allinst" platform="ldc"
    dflags "--link-defaultlib-shared=false" platform="linux-ldc"
    dflags "-defaultlib=libphobos2.a" platform="linux-dmd"
    lflags "--export-dynamic" platform="linux-ldc"
}
// END managed build types
