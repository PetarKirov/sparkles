{
    "code": "/// Keeps the readings above three, then scales what is left by ten.\nint[] scaled(int[] readings)\n{\n    auto loud = readings.filter!(x => x > 3);\n    auto tenfold = loud.map!(x => x * 10);\n    return tenfold.array;\n}\n",
