name "twoslash-d"
description "D-native twoslash analyzer: notation parsing + node assembly over sparkles:dmd-lsp"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetPath "build"
importPaths "src"

dflags "-preview=in" "-preview=dip1000"

// Optimized with assertions kept (`BLD6`) — the build to use for anything
// linking the DMD frontend, which relies on its asserts to catch a fork that
// has drifted. See `apps/twoslash-extract/dub.sdl` for the measurements.
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}

configuration "library" {
    targetType "library"
    dependency "sparkles:base" path="../.."
    dependency "sparkles:dmd-lsp" path="../.."
    dependency "sparkles:twoslash-protocol" path="../.."
    dependency "sparkles:wired" path="../.."
}

configuration "unittest" {
    // Fast path: depend on the runner shim (pulls the prebuilt impl library),
    // so `dub test` recompiles only this package, not the runner sources.
    dependency "sparkles:test-runner" path="../.."
    dependency "sparkles:base" path="../.."
    dependency "sparkles:dmd-lsp" path="../.."
    dependency "sparkles:twoslash-protocol" path="../.."
    dependency "sparkles:wired" path="../.."

    // No -checkaction=context / -allinst (the repo-standard unittest flags):
    // like sparkles:dmd-lsp, they leak into the dmd:frontend dependency's
    // compilation in the same invocation — undefined _d_assert_fail
    // instantiations at link, and -allinst over the 40 MB frontend.
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
