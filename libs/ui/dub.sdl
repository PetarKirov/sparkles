name "ui"
description "Canvas-first three-level UI toolkit (state/layout/widgets) — GUI, TUI, and HTML backends"
authors "Petar Kirov"
copyright "Copyright © 2026, Petar Kirov"
license "BSL-1.0"

targetPath "build"

// `../math/src` is import-only (all-template `Vector`, which `ui.geometry`
// specializes into `Point`/`Size`): a real `dependency "sparkles:math"` would
// close a dub dependency cycle once `core-cli` depends on this package for its
// help output — `core-cli -> ui -> math -> (math's unittest) -> test-runner ->
// test-runner-impl -> core-cli`. Dub's cycle detection unions across configs, so
// the edge counts even though only math's *test* build needs the runner.
// `../test-runner/src` is here for the same reason: see the unittest
// configuration below. This is the recipe `sparkles:core-cli` documents.
importPaths "src" "../test-runner/src" "../math/src"

// sparkles:base supplies the color/style vocabulary (RgbColor/Color/toRgb — the
// toolkit adds no color type of its own). Concrete canvas backends adapt to
// sparkles:ui, never the reverse.
dependency "sparkles:base" path="../.."
dependency "sparkles:input" path="../.."

// `expected` is declared rather than inherited through base's import paths: the
// table component returns `Expected` in its public API, so it is this package's
// dependency (`PKG2`).
dependency "expected" version="~>0.4.1"

dflags "-preview=in" "-preview=dip1000"

configuration "library" {
    // A real library, not a sourceLibrary: the toolkit carries the whole
    // component set, and recompiling it inside every dependent is the cost
    // `sparkles:core-cli` is a `library` to avoid. The templated parts (the
    // `isCanvas` capability concept, the attribute-inferring `paint`
    // interpreter) still instantiate in the consumer, as templates must.
    targetType "library"
}

configuration "unittest" {
    // Cycle-safe path: `core-cli` depends on this package, and `core-cli` is in
    // the impl library's dependency closure, so a `dependency` on the runner
    // shim would close `ui -> test-runner -> impl -> core-cli -> ui`. Source-
    // include the shim and the impl instead, as `base`/`core-cli`/`test-utils`
    // do for the same reason.
    sourcePaths "../test-runner/src" "../test-runner-impl/src"
    importPaths "src" "../test-runner/src" "../test-runner-impl/src" "../math/src"

    // The component tests use the diff/outdent helpers. `test-utils` depends on
    // `base` alone, so this edge closes no cycle.
    dependency "sparkles:test-utils" path="../.."

    // The keymap/lantern test fixture (`TestCommand`/`testBindings`) is shared
    // across this package's modules, so it is declared at module scope — but
    // guarded by this version, not `unittest`: a downstream `-unittest` build
    // (hue's, say) analyses imported `version (unittest)` declarations too, and
    // DMD then expects `Binding!(TestCommand, TestScope)`'s symbols from this
    // library — which is compiled *without* `-unittest` and has none of it.
    versions "UiKeymapFixtures"

    dflags "-checkaction=context" "-allinst"
    dflags "-defaultlib=libphobos2.so" "-L-fuse-ld=gold" platform="linux-dmd"
    dflags "--link-defaultlib-shared" "--linker=gold" platform="linux-ldc"
    lflags "--export-dynamic" platform="linux-ldc"
}
// Optimised, assertions live, `debug {}` blocks out — the build every nix
// artifact uses. Neither `debug` (which compiles those blocks in) nor
// `release` (which deletes assert *expressions*, side effects included).
buildType "checked" {
    buildOptions "optimize" "inline" "debugInfo"
}
