{
  "$extensions": {
    "dev.petar-kirov.sparkles": {
      "name": "github-dark"
    }
  },
  "page": {
    "bg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1412, 0.1608, 0.1804],
        "hex": "#24292e"
      }
    },
    "fg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.8824, 0.8941, 0.9098],
        "hex": "#e1e4e8"
      }
    }
  },
  "syntax": {
    "comment": {
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4157, 0.451, 0.4902],
          "hex": "#6a737d"
        }
      }
    },
    "constant": {
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4745, 0.7216, 1],
          "hex": "#79b8ff"
        }
      }
    },
    "diff": {
      "delta": {
        "bg": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.7608, 0.3059, 0],
            "hex": "#c24e00"
          }
        },
        "fg": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [1, 0.6706, 0.4392],
            "hex": "#ffab70"
          }
        }
      },
      "minus": {
        "bg": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.5255, 0.0941, 0.1137],
            "hex": "#86181d"
          }
        },
        "fg": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9922, 0.6824, 0.7176],
            "hex": "#fdaeb7"
          }
        }
      },
      "plus": {
        "bg": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.0784, 0.2745, 0.1255],
            "hex": "#144620"
          }
        },
        "fg": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.5216, 0.9098, 0.6157],
            "hex": "#85e89d"
          }
        }
      }
    },
    "error": {
      "$extensions": {
        "dev.petar-kirov.sparkles": {
          "attrs": ["italic"]
        }
      },
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9922, 0.6824, 0.7176],
          "hex": "#fdaeb7"
        }
      }
    },
    "keyword": {
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.9765, 0.4588, 0.5137],
          "hex": "#f97583"
        }
      },
      "storage": {
        "fg": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9765, 0.4588, 0.5137],
            "hex": "#f97583"
          }
        }
      }
    },
    "markup": {
      "bold": {
        "$extensions": {
          "dev.petar-kirov.sparkles": {
            "attrs": ["bold"]
          }
        },
        "fg": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.8824, 0.8941, 0.9098],
            "hex": "#e1e4e8"
          }
        }
      },
      "heading": {
        "$extensions": {
          "dev.petar-kirov.sparkles": {
            "attrs": ["bold"]
          }
        },
        "fg": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.4745, 0.7216, 1],
            "hex": "#79b8ff"
          }
        }
      },
      "italic": {
        "$extensions": {
          "dev.petar-kirov.sparkles": {
            "attrs": ["italic"]
          }
        },
        "fg": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.8824, 0.8941, 0.9098],
            "hex": "#e1e4e8"
          }
        }
      },
      "quote": {
        "fg": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.5216, 0.9098, 0.6157],
            "hex": "#85e89d"
          }
        }
      },
      "strikethrough": {
        "$extensions": {
          "dev.petar-kirov.sparkles": {
            "attrs": ["strikethrough"]
          }
        }
      }
    },
    "string": {
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.6196, 0.7961, 1],
          "hex": "#9ecbff"
        }
      },
      "regexp": {
        "fg": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.8588, 0.9294, 1],
            "hex": "#dbedff"
          }
        }
      },
      "special": {
        "url": {
          "$extensions": {
            "dev.petar-kirov.sparkles": {
              "underline": {
                "style": "single"
              }
            }
          },
          "fg": {
            "$type": "color",
            "$value": {
              "colorSpace": "srgb",
              "components": [0.8588, 0.9294, 1],
              "hex": "#dbedff"
            }
          }
        }
      }
    },
    "tag": {
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.5216, 0.9098, 0.6157],
          "hex": "#85e89d"
        }
      }
    },
    "variable": {
      "builtin": {
        "fg": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.4745, 0.7216, 1],
            "hex": "#79b8ff"
          }
        }
      },
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.8824, 0.8941, 0.9098],
          "hex": "#e1e4e8"
        }
      },
      "parameter": {
        "fg": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.8824, 0.8941, 0.9098],
            "hex": "#e1e4e8"
          }
        }
      }
    }
  }
}
