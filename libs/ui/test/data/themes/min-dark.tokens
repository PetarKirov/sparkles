{
  "$extensions": {
    "dev.petar-kirov.sparkles": {
      "name": "min-dark"
    }
  },
  "page": {
    "bg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1216, 0.1216, 0.1216],
        "hex": "#1f1f1f"
      }
    }
  },
  "syntax": {
    "comment": {
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.4196, 0.451, 0.4863],
          "hex": "#6b737c"
        }
      }
    },
    "constant": {
      "builtin": {
        "fg": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.4745, 0.7216, 1],
            "hex": "#79b8ff"
          }
        }
      },
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.702, 0.5725, 0.9412],
          "hex": "#b392f0"
        }
      },
      "numeric": {
        "fg": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
