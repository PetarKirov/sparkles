{
  "$extensions": {
    "dev.petar-kirov.sparkles": {
      "name": "light-plus"
    }
  },
  "page": {
    "bg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "fg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0, 0],
        "hex": "#000000"
      }
    }
  },
  "syntax": {
    "comment": {
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0, 0.502, 0],
          "hex": "#008000"
        }
      }
    },
    "constant": {
      "builtin": {
        "fg": {
