{
  "$extensions": {
    "dev.petar-kirov.sparkles": {
      "name": "material-theme-darker"
    }
  },
  "page": {
    "bg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1294, 0.1294, 0.1294],
        "hex": "#212121"
      }
    },
    "fg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9333, 1, 1],
        "hex": "#eeffff"
      }
    }
  },
  "syntax": {
    "comment": {
      "$extensions": {
        "dev.petar-kirov.sparkles": {
          "attrs": ["italic"]
        }
      },
      "fg": {
        "$type": "color",
