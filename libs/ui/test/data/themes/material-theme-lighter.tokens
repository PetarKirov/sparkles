{
  "$extensions": {
    "dev.petar-kirov.sparkles": {
      "name": "material-theme-lighter"
    }
  },
  "page": {
    "bg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.9804, 0.9804, 0.9804],
        "hex": "#fafafa"
      }
    },
    "fg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.5647, 0.6431, 0.6824],
        "hex": "#90a4ae"
      }
    }
  },
