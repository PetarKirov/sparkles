{
  "$extensions": {
    "dev.petar-kirov.sparkles": {
      "name": "min-light"
    }
  },
  "page": {
    "bg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    },
    "fg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.1294, 0.1294, 0.1294],
        "hex": "#212121"
      }
    }
  },
  "syntax": {
    "comment": {
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.7608, 0.7647, 0.7725],
          "hex": "#c2c3c5"
        }
      }
    },
    "constant": {
      "builtin": {
        "fg": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.098, 0.4627, 0.8235],
            "hex": "#1976d2"
          }
        }
      },
      "fg": {
        "$type": "color",
