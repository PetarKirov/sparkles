{
  "$extensions": {
    "dev.petar-kirov.sparkles": {
      "name": "vesper"
    }
  },
  "page": {
    "bg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.0627, 0.0627, 0.0627],
        "hex": "#101010"
      }
    },
    "fg": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      }
    }
  },
