{
  "colors": {
    "blue": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0, 0.4, 0.8],
        "hex": "#0066cc"
      },
      "$type": "color"
    }
  },
  "semantic": {
    "primary": {
      "$ref": "#/colors/blue/$value",
      "$type": "color"
    },
    "primaryHue": {
      "$ref": "#/colors/blue/$value/components/0",
      "$type": "number"
    }
  }
}
